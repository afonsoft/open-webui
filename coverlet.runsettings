<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <Exclude>[OpenWebUI.Client]*,[OpenWebUI.Server.Tests]*,[OpenWebUI.Api.Tests]*,[*]*.Migrations.*,[OpenWebUI.Api]Microsoft.AspNetCore.OpenApi.*,[*]AutoGeneratedProgram</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
