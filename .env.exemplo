# ============================================================
# Open WebUI (.NET) — variáveis de ambiente
#
# Copie para .env e ajuste:  cp .env.exemplo .env
# O docker compose lê o .env automaticamente (portas e env_file).
# NÃO commite o .env — somente este arquivo de exemplo.
# ============================================================

# Porta publicada do app no host → http://localhost:WEBUI_PORT
WEBUI_PORT=3000

# Ambiente ASP.NET Core. Development habilita OpenAPI e WASM debugging.
# ASPNETCORE_ENVIRONMENT=Production

# String de conexão EF Core. O default da imagem já grava no volume.
# ConnectionStrings__Default=Data Source=/app/data/openwebui.db

# ------------------------------------------------------------
# Providers de IA — semeados como conexões SOMENTE no primeiro
# boot (depois gerencie em Configurações → Conexões, como admin).
# O sufixo "S" aceita múltiplos valores separados por ";".
# ------------------------------------------------------------

# Ollama local (fora do compose) ou remoto:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URLS=http://ollama1:11434;http://ollama2:11434

# OpenAI ou qualquer API compatível (LiteLLM, Azure, etc.):
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_BASE_URLS=https://api.openai.com/v1;https://outro/v1
# OPENAI_API_KEY=sk-...
# OPENAI_API_KEYS=sk-um;sk-dois

# ------------------------------------------------------------
# RAG — modelo de embeddings (Knowledge)
# ------------------------------------------------------------
# RAG_EMBEDDING_MODEL=nomic-embed-text              # via Ollama (default)
# RAG_EMBEDDING_MODEL_OPENAI=text-embedding-3-small # via OpenAI-compat (default)

# ------------------------------------------------------------
# Áudio — STT via faster-whisper-server (speech-to-text)
# ------------------------------------------------------------
# WHISPER_URL=http://localhost:8000

# ------------------------------------------------------------
# OAuth / OIDC — login social (botões na tela de auth)
# ------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_CLIENT_TENANT_ID=common
# OPENID_PROVIDER_URL=https://seu-idp.exemplo.com
# OPENID_CLIENT_ID=
# OPENID_CLIENT_SECRET=

# ------------------------------------------------------------
# LDAP — bind de usuários corporativos
# ------------------------------------------------------------
# LDAP_SERVER=ldap.exemplo.com
# LDAP_PORT=389
# LDAP_USER_DN_TEMPLATE=uid={username},ou=users,dc=exemplo,dc=com
# LDAP_MAIL_ATTRIBUTE=mail
# LDAP_NAME_ATTRIBUTE=cn
# LDAP_SEARCH_BASE=ou=users,dc=exemplo,dc=com

# ------------------------------------------------------------
# Execução de código — tools Python e terminal Jupyter local
# (a imagem Docker não traz Python/Jupyter: só útil fora do container)
# ------------------------------------------------------------
# PYTHON_PATH=python3
# JUPYTER_LOCAL_COMMAND=jupyter lab --no-browser --port={port} --ServerApp.token={token} --ServerApp.root_dir={workdir}
# Jupyter__SpawnTimeoutSeconds=30

# ------------------------------------------------------------
# Stack completa (docker-compose.full.yaml) — portas dos serviços
# ------------------------------------------------------------
# OLLAMA_PORT=11434
# WHISPER_PORT=8000
