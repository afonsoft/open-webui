@* Gráfico de barras SVG simples para séries DayCount (analytics). *@
@inject LocalizationService L
@using System.Globalization

<svg viewBox="0 0 @(Width) @(Height)" class="w-full h-24 text-gray-400 dark:text-gray-500" role="img" aria-label="@L["admin.chart"]">
    @foreach (var bar in Bars)
    {
        <rect x="@Fmt(bar.X)" y="@Fmt(bar.Y)" width="@Fmt(bar.W)" height="@Fmt(bar.H)" rx="1"
              class="fill-gray-300 dark:fill-gray-600" />
    }
</svg>

@code {
    /// <summary>Pontos (dia, contagem) já ordenados.</summary>
    [Parameter] public IReadOnlyList<DayCount> Points { get; set; } = [];

    private const int Width = 300;
    private const int Height = 96;

    private IEnumerable<(double X, double Y, double W, double H)> Bars
    {
        get
        {
            if (Points.Count == 0)
            {
                yield break;
            }

            var max = Math.Max(1, Points.Max(p => p.Count));
            var step = (double)Width / Points.Count;
            for (var i = 0; i < Points.Count; i++)
            {
                var h = Height * (Points[i].Count / (double)max);
                yield return (i * step + 1, Height - h, step - 2, h);
            }
        }
    }

    // SVG exige separador decimal '.' — a cultura pt-BR renderizaria "68,57".
    private static string Fmt(double value) =>
        value.ToString("0.###", CultureInfo.InvariantCulture);
}
