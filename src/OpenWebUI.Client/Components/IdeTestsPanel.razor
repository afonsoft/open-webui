@inject IdeTestRunService Tests
@inject LocalizationService L
@implements IDisposable

@*
    Aba Tests compartilhada (SPEC-20261009-ide-mentions-tests, RF-004):
    idle → botão Run tests; gated → cartão de aprovação com o comando
    visível; running → spinner; fim → badge ✓/✗ + contagens + log.
*@
<div class="flex h-full flex-col gap-2 overflow-y-auto p-2 text-xs">
    @if (Tests.ApprovalPending)
    {
        <div class="rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-950/30 p-3">
            <div class="mb-1 font-medium text-amber-800 dark:text-amber-300">@L["ide.tests_approve_title"]</div>
            <p class="mb-1 text-[0.6875rem] text-gray-600 dark:text-gray-400">@L["ide.tests_approve_desc"]</p>
            <code class="mb-2 block truncate rounded bg-gray-100 dark:bg-gray-850 px-2 py-1 font-mono text-[0.6875rem] text-gray-800 dark:text-gray-200">@Tests.PendingCommand</code>
            <div class="flex gap-2">
                <button class="auth-submit !w-auto px-3 py-1 text-[0.6875rem]"
                        @onclick="ApproveAsync">@L["ide.tests_approve"]</button>
                <button class="rounded-lg border border-gray-200 dark:border-gray-700 px-3 py-1 text-[0.6875rem] text-gray-600 dark:text-gray-300"
                        @onclick="() => Tests.Reject()">@L["ide.tests_reject"]</button>
            </div>
        </div>
    }

    @if (Tests.Error is { } error)
    {
        <div class="rounded-lg border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-950/30 p-2 text-[0.6875rem] text-red-700 dark:text-red-300">@error</div>
    }

    @if (Tests.Run is { } run)
    {
        <div class="flex flex-wrap items-center gap-2 rounded-lg border border-gray-100 dark:border-gray-800 px-2 py-1.5">
            @if (run.State == "running")
            {
                <span class="inline-block size-3.5 animate-spin rounded-full border-2 border-blue-500 border-t-transparent" role="status" aria-label="@L["ide.tests_running"]"></span>
                <span class="text-gray-600 dark:text-gray-300">@L["ide.tests_running"]</span>
            }
            else if (run.State == "completed" && (run.Summary?.Failed ?? 0) == 0 && run.ExitCode is null or 0)
            {
                <span class="test-badge bg-green-500" aria-label="OK">✓</span>
                <span class="text-gray-700 dark:text-gray-300">@run.State</span>
            }
            else
            {
                <span class="test-badge bg-red-500" aria-label="FAIL">✗</span>
                <span class="text-gray-700 dark:text-gray-300">@run.State</span>
            }
            @if (run.Command is { } cmd)
            {
                <code class="truncate font-mono text-[0.6875rem] text-gray-400 dark:text-gray-500">@cmd</code>
            }
        </div>

        @if (run.Summary is { } s && (s.Passed is not null || s.Failed is not null || s.Skipped is not null))
        {
            <div class="flex flex-wrap gap-3 px-1 text-[0.6875rem]">
                <span class="text-green-600 dark:text-green-400">@s.Passed @L["ide.tests_passed"]</span>
                <span class="text-red-600 dark:text-red-400">@s.Failed @L["ide.tests_failed"]</span>
                <span class="text-gray-500 dark:text-gray-400">@s.Skipped @L["ide.tests_skipped"]</span>
                @if (s.DurationMs is { } ms)
                {
                    <span class="text-gray-400 dark:text-gray-500">@($"{ms / 1000.0:0.0}s")</span>
                }
            </div>
        }
        else if (run.State != "running")
        {
            <div class="px-1 text-[0.6875rem] text-gray-500 dark:text-gray-400">@L["ide.tests_no_counts"]</div>
        }

        @if (!string.IsNullOrEmpty(run.Tail))
        {
            <pre class="test-log">@run.Tail</pre>
        }
    }
    else if (Tests.Running)
    {
        <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400">
            <span class="inline-block size-3.5 animate-spin rounded-full border-2 border-blue-500 border-t-transparent" role="status" aria-label="@L["ide.tests_running"]"></span>
            @L["ide.tests_running"]
        </div>
    }
    else
    {
        <div class="text-[0.6875rem] text-gray-500 dark:text-gray-400">@L["ide.tests_empty"]</div>
    }

    @if (!Tests.Running && !Tests.ApprovalPending)
    {
        <button class="auth-submit !w-auto self-start px-3 py-1.5 text-[0.6875rem]"
                @onclick="RunAsync">@L["ide.run_tests"]</button>
    }
</div>

@code {
    /// <summary>Inscrição no estado compartilhado do runner.</summary>
    protected override void OnInitialized() => Tests.Changed += OnChanged;

    /// <summary>Limpa a inscrição ao sair do painel.</summary>
    public void Dispose() => Tests.Changed -= OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task RunAsync() => Tests.StartAsync();

    private Task ApproveAsync() => Tests.ApproveAsync();
}
