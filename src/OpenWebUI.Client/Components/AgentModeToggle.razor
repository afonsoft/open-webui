@inject LocalizationService L

@* Toggle plan↔build no composer (SPEC-20261009 RF-004): botão pill com
   ícone + rótulo, <c>aria-pressed</c> espelhando plan ativo e keyboard
   nativo de button (Enter/Espaço). *@
<button class="inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1.5 text-[0.6875rem] font-medium transition cursor-pointer disabled:opacity-40 @AgentModeVisuals.ChipClass(Mode)"
        title="@AgentModeVisuals.ToggleTitle(L, Mode)"
        aria-label="@AgentModeVisuals.ToggleTitle(L, Mode)"
        aria-pressed="@(AgentModeVisuals.Normalize(Mode) == "plan" ? "true" : "false")"
        disabled="@Disabled"
        @onclick="OnToggle">
    @AgentModeVisuals.Icon(Mode)
    <span class="hidden sm:inline">@AgentModeVisuals.Label(L, Mode)</span>
</button>

@code {
    /// <summary>Modo atual do agente (<c>build</c> | <c>plan</c>).</summary>
    [Parameter] public string Mode { get; set; } = "build";

    /// <summary>Desabilita o toggle (chat carregando).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback do clique — o pai decide o novo modo.</summary>
    [Parameter] public EventCallback OnToggle { get; set; }
}
