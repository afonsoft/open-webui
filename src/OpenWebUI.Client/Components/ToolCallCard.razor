@inject LocalizationService L

@*
    Card de uma chamada de tool (SPEC-20261007-chat-tool-streaming):
    nome + estado (executando/ok/negado/erro) + argumentos e resultado
    expansíveis. Serve tanto para os eventos vivos do SSE quanto para
    mensagens persistidas (assistant.tool_calls / role=tool).
*@

<div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50/60 dark:bg-gray-900/40 overflow-hidden">
    <button class="flex w-full items-center gap-2 px-3 py-1.5 text-xs text-gray-600 dark:text-gray-300 cursor-pointer"
            @onclick="() => _open = !_open" aria-expanded="@_open">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5 flex-none">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
        </svg>
        <span class="font-mono truncate font-medium">@Name</span>

        @if (Running)
        {
            <span class="ml-auto flex items-center gap-1 text-blue-600 dark:text-blue-400">
                <svg class="size-3 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z" />
                </svg>
                @L["chat.tool_running"]
            </span>
        }
        else if (Denied)
        {
            <span class="ml-auto rounded-full bg-amber-100 dark:bg-amber-900/40 px-2 py-0.5 text-[0.625rem] font-medium text-amber-700 dark:text-amber-300">
                @L["chat.tool_denied"]
            </span>
        }
        else if (Ok == false)
        {
            <span class="ml-auto rounded-full bg-red-100 dark:bg-red-900/40 px-2 py-0.5 text-[0.625rem] font-medium text-red-700 dark:text-red-300">
                @L["chat.tool_error"]
            </span>
        }
        else if (Ok == true)
        {
            <span class="ml-auto rounded-full bg-green-100 dark:bg-green-900/40 px-2 py-0.5 text-[0.625rem] font-medium text-green-700 dark:text-green-300">
                ok
            </span>
        }
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"
             class="size-3.5 flex-none transition-transform @(_open ? "rotate-180" : "")">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
    </button>

    @if (_open && (ArgsPreview is not null || ResultPreview is not null || ImagePath is not null))
    {
        <div class="border-t border-gray-200 dark:border-gray-800 px-3 py-2 flex flex-col gap-2">
            @if (ArgsPreview is not null)
            {
                <pre class="max-h-40 overflow-auto whitespace-pre-wrap break-all rounded-lg bg-white dark:bg-gray-950 px-2 py-1 text-[0.6875rem] font-mono text-gray-600 dark:text-gray-400">@ArgsPreview</pre>
            }
            @if (ImagePath is not null)
            {
                <img src="@ImagePath" alt="@Name" class="max-w-sm rounded-lg border border-gray-200 dark:border-gray-800" />
            }
            @if (ResultPreview is not null)
            {
                <pre class="max-h-40 overflow-auto whitespace-pre-wrap break-all rounded-lg bg-white dark:bg-gray-950 px-2 py-1 text-[0.6875rem] font-mono text-gray-600 dark:text-gray-400">@ResultPreview</pre>
            }
        </div>
    }
</div>

@code {
    /// <summary>Nome da tool.</summary>
    [Parameter] public string Name { get; set; } = "tool";

    /// <summary>Preview dos argumentos (truncado a 2KB, scrubbed).</summary>
    [Parameter] public string? ArgsPreview { get; set; }

    /// <summary>Preview do resultado.</summary>
    [Parameter] public string? ResultPreview { get; set; }

    /// <summary>Caminho da imagem gerada, quando a tool produziu uma.</summary>
    [Parameter] public string? ImagePath { get; set; }

    /// <summary>True enquanto a tool executa (entre tool_call e tool_result).</summary>
    [Parameter] public bool Running { get; set; }

    /// <summary>True se a call foi negada pelo usuário.</summary>
    [Parameter] public bool Denied { get; set; }

    /// <summary>Sucesso da execução; null = desconhecido.</summary>
    [Parameter] public bool? Ok { get; set; }

    private bool _open;
}
