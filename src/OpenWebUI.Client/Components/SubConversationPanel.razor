@inject ApiService Api
@inject LocalizationService L

@*
    Thread embutida de um chat filho (delegate_task / sub-agente) — mesmo
    padrão do Devin web: a conversa da sub-sessão aparece abaixo da call
    que a criou, em painel próprio com scroll interno (não cresce além de
    ~16rem). Cada mensagem é condensada: prompt delegado, resposta do
    assistant e linhas compactas de tool. Link pro transcript completo
    continua no cabeçalho do ToolCallCard.
*@

<div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 overflow-hidden"
     data-testid="subconversation">
    <div class="flex items-center gap-1.5 border-b border-gray-100 dark:border-gray-850 bg-gray-50/80 dark:bg-gray-900/60 px-2.5 py-1 text-[0.6875rem] font-medium text-gray-500 dark:text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3 flex-none" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 3v1.5M4.5 8.25H3m18 0h-1.5M4.5 12H3m18 0h-1.5m-15 3.75H3m18 0h-1.5M8.25 19.5V21M12 3v1.5m0 15V21m3.75-18v1.5m0 15V21m-9-1.5h10.5a2.25 2.25 0 0 0 2.25-2.25V6.75a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 6.75v10.5a2.25 2.25 0 0 0 2.25 2.25Zm.75-12h9v9h-9z" />
        </svg>
        <span class="truncate">@(_chat?.Title is { Length: > 0 } title ? title : L["chat.subchat_title"])</span>
    </div>

    @if (_loading)
    {
        <div class="px-2.5 py-2 text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["common.loading"]</div>
    }
    else if (_chat is null)
    {
        <div class="px-2.5 py-2 text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.subchat_unavailable"]</div>
    }
    else if (_chat.Messages.Count == 0)
    {
        <div class="px-2.5 py-2 text-[0.6875rem] text-gray-400 dark:text-gray-500">@L["chat.subchat_empty"]</div>
    }
    else
    {
        <div class="max-h-64 overflow-y-auto px-2.5 py-2 flex flex-col gap-1.5">
            @foreach (var m in _chat.Messages)
            {
                switch (m.Role)
                {
                    case "user":
                        @* Prompt delegado pelo pai — primeira mensagem do filho. *@
                        <div class="text-[0.6875rem] leading-relaxed">
                            <span class="mr-1 font-medium text-blue-600 dark:text-blue-400">@L["chat.subchat_prompt"]</span>
                            <span class="whitespace-pre-wrap break-words text-gray-600 dark:text-gray-300">@m.Content</span>
                        </div>
                        break;
                    case "assistant":
                        <div class="whitespace-pre-wrap break-words text-[0.6875rem] leading-relaxed text-gray-700 dark:text-gray-300">@m.Content</div>
                        break;
                    case "tool":
                        <div class="flex items-center gap-1 text-[0.6875rem] text-gray-400 dark:text-gray-500">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-2.5 flex-none" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" />
                            </svg>
                            <span class="truncate font-mono">@(m.ToolCallId ?? "tool")</span>
                        </div>
                        break;
                }
            }
        </div>
    }
</div>

@code {
    /// <summary>Id do chat filho a embutir.</summary>
    [Parameter, EditorRequired] public required string ChatId { get; set; }

    private ChatResponse? _chat;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _chat = await Api.GetChatAsync(ChatId);
        }
        catch
        {
            _chat = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
