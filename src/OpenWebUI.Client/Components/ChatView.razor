@inject ApiService Api
@inject ChatStreamService ChatStream
@inject AuthService Auth
@inject ChatListState ChatList
@inject NavigationManager Nav
@inject LocalizationService L
@inject MarkdownService Markdown
@inject IJSRuntime JS
@inject RealtimeService Realtime
@implements IDisposable

<div class="flex flex-col flex-1 h-full w-full min-w-0">
    <div class="sticky top-0 z-30 w-full">
        <div class="flex items-center w-full pl-1.5 pr-1">
            <div class="flex max-w-full w-full mx-auto bg-transparent">
                <div class="flex items-center w-full max-w-full">
                    <div class="flex-1 max-w-full mt-0.5 py-0.5 pl-1">
                        <div class="flex max-w-full min-w-0 items-center gap-2 mr-2">
                            <ModelSelector Value="@_model" ValueChanged="OnModelChanged" />
                        </div>
                    </div>
                    <div class="lg:mr-1 flex flex-none items-center gap-2 self-center">
                        @if (_voiceSupported)
                        {
                            <button class="flex size-6 cursor-pointer items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-50/40 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800/40 dark:hover:text-gray-200"
                                    title="@L["voice.call"]" aria-label="@L["voice.call"]" @onclick="() => _callActive = true">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" /></svg>
                            </button>
                        }
                        @if (_loadedChatId is not null)
                        {
                            <button class="flex size-6 cursor-pointer items-center justify-center rounded-lg text-gray-500 transition hover:bg-gray-50/40 hover:text-gray-700 dark:text-gray-400 dark:hover:bg-gray-800/40 dark:hover:text-gray-200"
                                    title="@L["chat.share"]" aria-label="@L["chat.share"]" @onclick="ShareAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z" /></svg>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="flex-1 overflow-y-auto scrollbar-hidden" @ref="_scrollContainer">
        <div class="mx-auto w-full max-w-4xl px-4 pb-6">
            @if (_messages.Count == 0 && !_loading)
            {
                <div class="flex flex-col items-center justify-center text-center min-h-[60vh]">
                    <img src="assets/splash-dark.png" alt="" class="size-24 rounded-full mb-4 dark:opacity-90" />
                    <div class="text-2xl font-normal text-gray-700 dark:text-gray-200">Open WebUI</div>
                    <div class="mt-1 text-sm text-gray-500 dark:text-gray-400">@L["chat.empty_help"]</div>
                    @if (_suggestions.Count > 0)
                    {
                        <div class="mt-6 flex flex-wrap justify-center gap-2">
                            @foreach (var suggestion in _suggestions.Take(4))
                            {
                                <button class="rounded-xl border border-gray-100 dark:border-gray-850 px-3 py-1.5 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-850 transition cursor-pointer"
                                        @onclick="() => UseSuggestion(suggestion)">
                                    @suggestion.Title
                                </button>
                            }
                        </div>
                    }
                    @if (_prompts.Count > 0)
                    {
                        <div class="mt-3 flex flex-wrap justify-center gap-2">
                            @foreach (var prompt in _prompts.Take(4))
                            {
                                <button class="rounded-xl border border-gray-100 dark:border-gray-850 px-3 py-1.5 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-850 transition cursor-pointer"
                                        @onclick="() => UsePrompt(prompt)">
                                    /@prompt.Command — @prompt.Title
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col gap-5 py-4" role="log" aria-live="polite" aria-relevant="additions">
                    @for (var i = 0; i < _messages.Count; i++)
                    {
                        var index = i;
                        var message = _messages[i];
                        var isLastAssistant = message.Role == "assistant" && i == _messages.Count - 1;
                        <MessageBubble
                            Message="message"
                            Streaming="_streaming && isLastAssistant"
                            ShowActions="true"
                            Initials="@UserInitials"
                            OnRegenerate="() => RegenerateAtAsync(index)"
                            OnEdit="() => EditAt(index)"
                            OnRate="rating => RateAsync(message, rating)"
                            OnGenerateImage="() => GenerateImageAtAsync(index)"
                            Speaking="_speakingIndex == index"
                            TtsSupported="_ttsSupported"
                            OnSpeak="() => SpeakAtAsync(index)" />
                    }
                </div>
            }

            @if (_arena is not null)
            {
                <div class="my-3 grid grid-cols-1 gap-3 md:grid-cols-2">
                    @foreach (var r in _arena.Responses)
                    {
                        <div class="rounded-xl border border-gray-100 dark:border-gray-850 px-4 py-3">
                            <div class="mb-1 text-xs font-semibold text-gray-500 dark:text-gray-400">
                                @(_arenaFeedback is null
                                    ? L.T("arena.model_label", ("label", r.Label))
                                    : r.Label == "A" ? _arenaFeedback.ModelA : _arenaFeedback.ModelB)
                            </div>
                            <div class="markdown-body text-sm text-gray-800 dark:text-gray-200">
                                @((MarkupString)Markdown.ToHtml(r.Content))
                            </div>
                        </div>
                    }
                </div>
                @if (_arenaFeedback is null)
                {
                    <div class="mb-3 flex flex-wrap gap-2">
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("a")'>@L["arena.vote_a"]</button>
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("tie")'>@L["arena.vote_tie"]</button>
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("both_bad")'>@L["arena.vote_both_bad"]</button>
                        <button class="rounded-full border border-gray-200 px-3 py-1.5 text-xs text-gray-600 transition hover:bg-gray-50 disabled:opacity-40 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-850"
                                disabled="@_arenaVoting" @onclick='() => VoteArenaAsync("b")'>@L["arena.vote_b"]</button>
                    </div>
                }
                else
                {
                    <div class="mb-3 text-xs text-gray-500 dark:text-gray-400">
                        @L.T("arena.revealed", ("a", _arenaFeedback.ModelA), ("b", _arenaFeedback.ModelB))
                        — @_arenaFeedback.RatingA.ToString("F0") / @_arenaFeedback.RatingB.ToString("F0")
                    </div>
                }
            }

            @if (_error is not null)
            {
                <div class="my-3 rounded-xl border border-red-200 dark:border-red-900/50 bg-red-50 dark:bg-red-900/20 px-4 py-2 text-sm text-red-600 dark:text-red-400" role="alert">@_error</div>
            }

            @if (_followUps.Count > 0 && !_streaming)
            {
                <div class="flex flex-col gap-1.5 mb-2">
                    @foreach (var suggestion in _followUps)
                    {
                        <button class="text-left rounded-xl border border-gray-100 dark:border-gray-850 px-3 py-2 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 transition cursor-pointer"
                                @onclick="() => SendFollowUpAsync(suggestion)">@suggestion</button>
                    }
                </div>
            }
        </div>
    </div>

    <div class="w-full bg-transparent">
        <div class="mx-auto w-full max-w-4xl px-4 pb-3">
            @if (_attachedFiles.Count > 0)
            {
                <div class="mb-1 mx-1 flex flex-wrap gap-1.5">
                    @foreach (var file in _attachedFiles)
                    {
                        <span class="flex items-center gap-1.5 rounded-xl bg-gray-100 dark:bg-gray-850 px-2.5 py-1 text-xs text-gray-700 dark:text-gray-300">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" /></svg>
                            @file.Filename
                            <button class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 cursor-pointer" @onclick="() => _attachedFiles.Remove(file)">×</button>
                        </span>
                    }
                </div>
            }

            <div class="flex-1 flex flex-col relative w-full shadow-lg rounded-3xl border border-gray-100/30 dark:border-gray-850/30 hover:border-gray-200 focus-within:border-gray-100 hover:dark:border-gray-800 focus-within:dark:border-gray-800 transition px-0.5 bg-white/5 dark:bg-gray-500/5 backdrop-blur-sm dark:text-gray-100">
                <div class="px-2 relative">
                    @if (_promptSuggestions.Count > 0)
                    {
                        <div class="mb-1 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/50 overflow-hidden">
                            @foreach (var p in _promptSuggestions)
                            {
                                <button class="w-full text-left px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer"
                                        @onclick="() => SelectPrompt(p)">/@p.Command @p.Title</button>
                            }
                        </div>
                    }
                    <textarea
                        class="scrollbar-hidden bg-transparent dark:text-gray-100 outline-none w-full py-3 px-1 resize-none h-fit max-h-96 overflow-auto placeholder:text-gray-400 dark:placeholder:text-gray-600 text-[0.9375rem]"
                        placeholder="@(_uploading ? L["chat.uploading"] : L["chat.input_placeholder"])"
                        rows="1"
                        @bind="_input"
                        @bind:event="oninput"
                        @onkeydown="OnKeyDown"
                        disabled="@_loading"></textarea>
                </div>

                <div class="flex justify-between mt-0.5 mb-2 mx-0.5 max-w-full" dir="ltr">
                    <div class="ml-1 self-end flex items-center flex-1 min-w-0">
                        @if (_tools.Count > 0 || _webSearchAvailable)
                        {
                            <div class="relative">
                                <button class="size-8 flex items-center justify-center rounded-full transition cursor-pointer disabled:opacity-40
                                               @(_toolIds.Count > 0 || _webSearch ? "bg-gray-900 text-white dark:bg-white dark:text-gray-900" : "text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800")"
                                        title="@L["chat.tools"]" aria-label="@L["chat.tools"]" disabled="@_loading"
                                        @onclick="() => _showToolsMenu = !_showToolsMenu">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17 17.25 21A2.652 2.652 0 0 0 21 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 1 1-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 0 0 4.486-6.336l-3.276 3.277a3.004 3.004 0 0 1-2.25-2.25l3.276-3.276a4.5 4.5 0 0 0-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437 1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008Z" /></svg>
                                </button>
                                @if (_showToolsMenu)
                                {
                                    <div class="absolute bottom-10 left-0 z-40 w-56 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800/50 shadow-lg overflow-hidden">
                                        @if (_webSearchAvailable)
                                        {
                                            <div class="px-3 py-2 text-xs font-medium text-gray-500 dark:text-gray-400">@L["chat.tools_features"]</div>
                                            <label class="flex items-center gap-2 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer">
                                                <input type="checkbox" checked="@_webSearch"
                                                       @onchange="ToggleWebSearchAsync" />
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4 flex-none"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0 0c2.5 0 4.5-4 4.5-9S14.5 3 12 3m0 18c-2.5 0-4.5-4-4.5-9S9.5 3 12 3m-8.7 6h17.4M3.3 15h17.4" /></svg>
                                                <span class="truncate">@L["chat.web_search"]</span>
                                            </label>
                                        }
                                        @if (_tools.Count > 0)
                                        {
                                            <div class="px-3 py-2 text-xs font-medium text-gray-500 dark:text-gray-400">@L["chat.tools_in_chat"]</div>
                                            @foreach (var tool in _tools)
                                            {
                                                <label class="flex items-center gap-2 px-3 py-1.5 text-sm text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-850 cursor-pointer">
                                                    <input type="checkbox" checked="@_toolIds.Contains(tool.Id)"
                                                           @onchange="() => ToggleToolAsync(tool.Id)" />
                                                    <span class="truncate">@tool.Name</span>
                                                </label>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <button class="size-8 flex items-center justify-center rounded-full text-gray-500 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800 transition cursor-pointer disabled:opacity-40"
                                title="@L["chat.attach"]" aria-label="@L["chat.attach"]" disabled="@(_loading || _uploading)"
                                @onclick="TriggerFilePicker">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg>
                        </button>
                        <InputFile @ref="_fileInput" OnChange="OnFileSelected" class="hidden" />
                        <VoiceButton Disabled="@(_loading || _streaming)" Lang="@SttLang"
                                     OnDictationStarted="() => _sttBase = _input"
                                     OnTranscript="OnSttTranscript"
                                     OnDictationEnded="OnSttDoneAsync"
                                     OnError="OnSttErr" />
                    </div>

                    <div class="self-end flex items-center gap-1 mr-1">
                        @if (_streaming)
                        {
                            <button class="size-8 flex items-center justify-center rounded-full bg-gray-900 text-white dark:bg-white dark:text-gray-900 transition cursor-pointer"
                                    title="@L["chat.stop"]" aria-label="@L["chat.stop"]" @onclick="StopStreaming">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4"><path fill-rule="evenodd" d="M4.5 7.5a3 3 0 0 1 3-3h9a3 3 0 0 1 3 3v9a3 3 0 0 1-3 3h-9a3 3 0 0 1-3-3v-9Z" clip-rule="evenodd" /></svg>
                            </button>
                        }
                        else
                        {
                            <button class="size-8 flex items-center justify-center rounded-full transition cursor-pointer disabled:opacity-40
                                           @(SendDisabled ? "bg-gray-100 text-gray-400 dark:bg-gray-800 dark:text-gray-600" : "bg-gray-900 text-white dark:bg-white dark:text-gray-900")"
                                    title="@L["chat.send"]" aria-label="@L["chat.send"]" disabled="@SendDisabled" @onclick="SendAsync">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5 12 3m0 0 7.5 7.5M12 3v18" /></svg>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-1.5 text-center text-[0.6875rem] text-gray-400 dark:text-gray-600">
                Open WebUI .NET — Blazor WebAssembly
            </div>
        </div>
    </div>

    <CallOverlay Active="_callActive" Lang="@SttLang"
                 OnTurn="ExecuteVoiceTurnAsync"
                 OnClose="() => _callActive = false" />
</div>

@code {
    /// <summary>Id do chat carregado; null para um chat novo.</summary>
    [Parameter] public string? ChatId { get; set; }

    /// <summary>Modo playground: conversa em memória, sem persistir chat.</summary>
    [Parameter] public bool Playground { get; set; }

    private readonly List<ChatMessageModel> _messages = [];
    private readonly List<FileResponse> _attachedFiles = [];
    private List<PromptResponse> _prompts = [];
    private List<PromptSuggestion> _suggestions = [];
    private List<PromptResponse> _promptSuggestions = [];
    private List<string> _followUps = [];
    private ArenaCompletionResult? _arena;
    private ArenaFeedbackResponse? _arenaFeedback;
    private bool _arenaVoting;
    private List<ToolResponse> _tools = [];
    private HashSet<string> _toolIds = [];
    private bool _showToolsMenu;
    private bool _webSearchAvailable;
    private bool _webSearch;
    private string? _loadedChatId;
    private string _chatTitle = "New Chat";
    private string? _model;
    private string _input = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _streaming;
    private bool _callActive;
    private bool _voiceSupported;
    private bool _ttsSupported;
    private string _sttBase = string.Empty;
    private int _speakingIndex = -1;
    private DotNetObjectReference<ChatView>? _ttsRef;

    private string SttLang => L.Language;
    private bool _uploading;
    private CancellationTokenSource? _cts;
    private ElementReference _scrollContainer;
    private InputFile? _fileInput;
    private string? _pendingNavigateId;

    private string UserInitials =>
        string.IsNullOrWhiteSpace(Auth.CurrentUser?.Name)
            ? "U"
            : Auth.CurrentUser!.Name.Trim()[0].ToString().ToUpperInvariant();

    private bool SendDisabled =>
        (string.IsNullOrWhiteSpace(_input) && _attachedFiles.Count == 0)
        || string.IsNullOrEmpty(_model) || _loading || _uploading;

    protected override async Task OnInitializedAsync()
    {
        _prompts = await Api.GetPromptsAsync();
        _tools = await Api.GetToolsAsync();
        _suggestions = (await Api.GetModelsConfigAsync())?.PromptSuggestions ?? [];
        _webSearchAvailable = (await Api.GetAppConfigCachedAsync())?.Features.EnableWebSearch ?? false;
        try
        {
            _webSearch = await JS.InvokeAsync<string?>("localStorage.getItem", "webui.chat.websearch") == "true";
        }
        catch (JSException ex)
        {
            Console.WriteLine($"localStorage indisponível: {ex.Message}");
        }
        Realtime.OnChatMessageUpdated += HandleChatMessageUpdated;
        Realtime.OnChatMessageDeleted += HandleChatMessageDeleted;
        await Realtime.ConnectAsync(Nav.BaseUri, Auth.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _voiceSupported = await JS.InvokeAsync<bool>("openwebui.audio.sttSupported");
            _ttsSupported = await JS.InvokeAsync<bool>("openwebui.audio.ttsSupported");
            if (_voiceSupported || _ttsSupported)
            {
                StateHasChanged();
            }
        }
    }

    private void OnSttTranscript(string text)
    {
        _input = string.IsNullOrEmpty(_sttBase) ? text : $"{_sttBase} {text}";
    }

    private async Task OnSttDoneAsync()
    {
        _sttBase = string.Empty;
        var autoSend = await JS.InvokeAsync<bool>("openwebui.audio.getAutoSend");
        if (autoSend && !SendDisabled)
        {
            await SendAsync();
        }
    }

    private void OnSttErr(string error)
    {
        _error = error == "not-allowed" ? L["voice.mic_denied"] : L["voice.stt_error"];
    }

    private async Task<string?> ExecuteVoiceTurnAsync(string text)
    {
        _input = text;
        await SendAsync();
        await InvokeAsync(StateHasChanged);
        if (_error is not null)
        {
            return null;
        }

        var reply = _messages.LastOrDefault(m => m.Role == "assistant")?.Content;
        return string.IsNullOrEmpty(reply) ? null : reply;
    }

    private async Task SpeakAtAsync(int index)
    {
        if (_speakingIndex == index)
        {
            await JS.InvokeVoidAsync("openwebui.audio.stopSpeak");
            _speakingIndex = -1;
            return;
        }

        _ttsRef ??= DotNetObjectReference.Create(this);
        var ok = await JS.InvokeAsync<bool>(
            "openwebui.audio.speak", _messages[index].Content, _ttsRef);
        _speakingIndex = ok ? index : -1;
    }

    /// <summary>Callback do JS quando a leitura (TTS) termina.</summary>
    [JSInvokable]
    public void OnTtsEnded() => _speakingIndex = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (ChatId == _loadedChatId)
        {
            return;
        }

        _error = null;
        _followUps = [];
        _attachedFiles.Clear();
        if (_loadedChatId is not null)
        {
            await Realtime.LeaveChatAsync(_loadedChatId);
        }
        if (ChatId is null)
        {
            _loadedChatId = null;
            _chatTitle = "New Chat";
            _messages.Clear();
            _toolIds.Clear();
            return;
        }

        _loading = true;
        try
        {
            var chat = await Api.GetChatAsync(ChatId);
            if (chat is null)
            {
                Nav.NavigateTo("/", replace: true);
                return;
            }

            _loadedChatId = chat.Id;
            await Realtime.JoinChatAsync(chat.Id);
            _chatTitle = chat.Title;
            _toolIds = chat.ToolIds.ToHashSet();
            _messages.Clear();
            _messages.AddRange(chat.Messages);
            if (chat.Models.Count > 0)
            {
                _model = chat.Models[0];
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnModelChanged(string? model) => _model = model;

    private void HandleChatMessageUpdated(string chatId, string messageId, string content)
    {
        if (chatId != _loadedChatId)
        {
            return;
        }

        var index = _messages.FindIndex(m => m.Id == messageId);
        if (index >= 0 && _messages[index].Content != content)
        {
            var m = _messages[index];
            var versions = (m.Versions ?? []).ToList();
            versions.Add(new ChatMessageVersionModel(m.Content, m.Model, m.Timestamp));
            _messages[index] = m with { Content = content, Versions = versions };
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void HandleChatMessageDeleted(string chatId, string messageId)
    {
        if (chatId != _loadedChatId)
        {
            return;
        }

        var index = _messages.FindIndex(m => m.Id == messageId);
        if (index >= 0)
        {
            _messages.RemoveRange(index, _messages.Count - index);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    /// <inheritdoc />
    public void Dispose()
    {
        Realtime.OnChatMessageUpdated -= HandleChatMessageUpdated;
        Realtime.OnChatMessageDeleted -= HandleChatMessageDeleted;
        _cts?.Dispose();
        _ttsRef?.Dispose();
        GC.SuppressFinalize(this);
    }

    private void UsePrompt(PromptResponse prompt)
    {
        _input = prompt.Content;
    }

    private void UseSuggestion(PromptSuggestion suggestion)
    {
        _input = suggestion.Content;
    }

    private void SelectPrompt(PromptResponse prompt)
    {
        _input = prompt.Content;
        _promptSuggestions = [];
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !SendDisabled && !_streaming)
        {
            await SendAsync();
            return;
        }

        UpdatePromptSuggestions();
    }

    private void UpdatePromptSuggestions()
    {
        _promptSuggestions = _input.StartsWith('/')
            ? _prompts
                .Where(p => p.Command.StartsWith(_input[1..], StringComparison.OrdinalIgnoreCase))
                .Take(5)
                .ToList()
            : [];
    }

    private async Task TriggerFilePicker()
    {
        await JS.InvokeVoidAsync("openwebui.openFilePicker", _fileInput?.Element);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _uploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(10))
            {
                await using var stream = file.OpenReadStream(100 * 1024 * 1024);
                var uploaded = await Api.UploadFileAsync(stream, file.Name, file.ContentType);
                if (uploaded is not null)
                {
                    _attachedFiles.Add(uploaded);
                }
                else
                {
                    _error = L.T("chat.upload_failed", ("file", file.Name));
                }
            }
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SendAsync()
    {
        var text = _input.Trim();
        var fileIds = _attachedFiles.Select(f => f.Id).ToList();
        if ((text.Length == 0 && fileIds.Count == 0) || string.IsNullOrEmpty(_model))
        {
            return;
        }

        _input = string.Empty;
        _promptSuggestions = [];
        _followUps = [];
        _error = null;

        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var content = text.Length > 0
            ? text
            : _attachedFiles.Count > 0 ? L["chat.files_attached"] : text;
        if (_attachedFiles.Count > 0 && text.Length > 0)
        {
            content += "\n\n📎 " + string.Join(", ", _attachedFiles.Select(f => f.Filename));
        }

        _messages.Add(new ChatMessageModel(Guid.NewGuid().ToString(), "user", content, null, now));
        _attachedFiles.Clear();

        var isNew = _loadedChatId is null && !Playground;
        if (isNew)
        {
            var title = text.Length > 60 ? text[..60] : text;
            if (string.IsNullOrEmpty(title))
            {
                title = "New Chat";
            }

            var created = await Api.CreateChatAsync(
                new ChatUpsertRequest(title, [_model!], _messages,
                    _toolIds.Count > 0 ? _toolIds.ToList() : []));
            if (created is null)
            {
                _error = L["chat.create_failed"];
                _messages.RemoveAt(_messages.Count - 1);
                return;
            }

            _loadedChatId = created.Id;
            _chatTitle = created.Title;
            _pendingNavigateId = created.Id;
            ChatList.NotifyChanged();
        }

        await StreamAssistantAsync(fileIds);
        await PersistAsync();

        if (_pendingNavigateId is not null)
        {
            var id = _pendingNavigateId;
            _pendingNavigateId = null;
            Nav.NavigateTo($"/c/{id}");
        }

        if (isNew)
        {
            _ = GenerateTitleAsync();
        }

        _ = LoadFollowUpsAsync();
    }

    private async Task SendFollowUpAsync(string text)
    {
        _input = text;
        _followUps = [];
        await SendAsync();
    }

    private void EditAt(int index)
    {
        if (_streaming)
        {
            return;
        }

        _input = _messages[index].Content;
    }

    private async Task RegenerateAtAsync(int index)
    {
        if (_streaming || _messages.Count == 0)
        {
            return;
        }

        // Remove a resposta na posição e tudo depois dela, depois gera de novo.
        while (_messages.Count > index)
        {
            _messages.RemoveAt(_messages.Count - 1);
        }

        if (_messages.Count == 0 || string.IsNullOrEmpty(_model))
        {
            return;
        }

        _error = null;
        _followUps = [];
        await StreamAssistantAsync([]);
        await PersistAsync();
        _ = LoadFollowUpsAsync();
    }

    private async Task GenerateImageAtAsync(int index)
    {
        if (_streaming)
        {
            return;
        }

        var message = _messages[index];
        List<GeneratedImage>? generated;
        try
        {
            generated = await Api.GenerateImagesAsync(message.Content);
        }
        catch (HttpRequestException)
        {
            generated = null;
        }

        if (generated is { Count: > 0 })
        {
            var markdown = string.Concat(generated.Select(g => $"\n\n![imagem gerada]({g.Url})"));
            _messages[index] = message with { Content = message.Content + markdown };
        }
        else
        {
            _messages[index] = message with
            {
                Content = $"{message.Content}\n\n> {L["chat.image_error"]}",
            };
        }

        await PersistAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RateAsync(ChatMessageModel message, int rating)
    {
        if (_loadedChatId is null)
        {
            return;
        }

        await Api.SaveFeedbackAsync(_loadedChatId, message.Id, message.Model, rating, null);
    }

    private async Task ShareAsync()
    {
        if (_loadedChatId is null)
        {
            return;
        }

        var updated = await Api.ShareChatAsync(_loadedChatId);
        if (updated?.ShareId is not null)
        {
            var url = $"{Nav.BaseUri.TrimEnd('/')}/s/{updated.ShareId}";
            await JS.InvokeVoidAsync("openwebui.copyText", url);
            _error = null;
        }
    }

    private async Task StreamAssistantAsync(IReadOnlyList<string> fileIds)
    {
        var placeholder = new ChatMessageModel(
            Guid.NewGuid().ToString(), "assistant", string.Empty, _model,
            DateTimeOffset.UtcNow.ToUnixTimeSeconds());
        _messages.Add(placeholder);
        var index = _messages.Count - 1;

        _streaming = true;
        _arena = null;
        _arenaFeedback = null;
        _cts = new CancellationTokenSource();
        var content = new System.Text.StringBuilder();

        try
        {
            var request = new ChatCompletionRequest(
                _model!,
                _messages.Take(index)
                    .Select(m => new ChatCompletionMessage(m.Role, m.Content))
                    .ToList(),
                Stream: true,
                FileIds: fileIds.Count > 0 ? fileIds : null,
                ToolIds: _toolIds.Count > 0 ? _toolIds.ToList() : null,
                WebSearch: _webSearch ? true : null);

            await foreach (var delta in ChatStream.StreamCompletionAsync(request, _cts.Token))
            {
                content.Append(delta);
                _messages[index] = placeholder with { Content = content.ToString() };
                await InvokeAsync(StateHasChanged);
                await ScrollToEndAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (ChatStream.LastArenaResult is { } arenaResult)
            {
                _arena = arenaResult;
            }
            _streaming = false;
            _cts?.Dispose();
            _cts = null;
        }
    }

    private async Task VoteArenaAsync(string winner)
    {
        if (_arena is null || _arenaVoting)
        {
            return;
        }
        _arenaVoting = true;
        try
        {
            var feedback = await Api.VoteArenaAsync(_arena.BattleId, winner);
            if (feedback is not null)
            {
                _arenaFeedback = feedback;
                var winnerModel = winner switch
                {
                    "a" => feedback.ModelA,
                    "b" => feedback.ModelB,
                    _ => null,
                };
                var label = winnerModel is null
                    ? L[winner == "tie" ? "arena.result_tie" : "arena.result_both_bad"]
                    : L.T("arena.result_winner", ("model", winnerModel));
                var index = _messages.Count - 1;
                if (index >= 0 && _messages[index].Role == "assistant")
                {
                    _messages[index] = _messages[index] with { Content = label };
                }
                await PersistAsync();
            }
        }
        finally
        {
            _arenaVoting = false;
        }
    }

    private void StopStreaming() => _cts?.Cancel();

    private async Task ToggleToolAsync(string toolId)
    {
        if (!_toolIds.Remove(toolId))
        {
            _toolIds.Add(toolId);
        }
        await PersistAsync();
    }

    private async Task ToggleWebSearchAsync()
    {
        _webSearch = !_webSearch;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "webui.chat.websearch",
                _webSearch ? "true" : "false");
        }
        catch (JSException ex)
        {
            Console.WriteLine($"localStorage indisponível: {ex.Message}");
        }
    }

    private async Task GenerateTitleAsync()
    {
        if (_loadedChatId is null || string.IsNullOrEmpty(_model))
        {
            return;
        }

        var title = await Api.GenerateTitleAsync(_model, _messages.Take(4).ToList(), _loadedChatId);
        if (!string.IsNullOrWhiteSpace(title))
        {
            _chatTitle = title;
            await PersistAsync();
        }
    }

    private async Task LoadFollowUpsAsync()
    {
        if (_loadedChatId is null || string.IsNullOrEmpty(_model) || _messages.Count < 2)
        {
            return;
        }

        var followUps = await Api.GenerateFollowUpsAsync(
            _model, _messages.TakeLast(6).ToList(), _loadedChatId);
        if (followUps.Count > 0)
        {
            _followUps = followUps.Take(3).ToList();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PersistAsync()
    {
        if (_loadedChatId is null)
        {
            return;
        }

        var updated = await Api.UpdateChatAsync(
            _loadedChatId,
            new ChatUpsertRequest(_chatTitle, _model is null ? [] : [_model], _messages,
                _toolIds.ToList()));
        if (updated is not null)
        {
            ChatList.NotifyChanged();
        }
    }

    private async Task ScrollToEndAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("openwebui.scrollToEnd", _scrollContainer);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"scrollToEnd falhou: {ex.Message}");
        }
    }
}
