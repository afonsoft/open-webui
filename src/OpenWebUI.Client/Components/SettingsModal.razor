    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            return;
        }

        _version = (await Api.GetVersionAsync())?.Version;
        _name = Auth.CurrentUser?.Name ?? string.Empty;
        _profileImage = Auth.CurrentUser?.ProfileImageUrl ?? string.Empty;
        _apiKeyInfo = await Api.GetApiKeyAsync();
        _memories = await Api.GetMemoriesAsync();

        _webhook = await Api.GetWebhookAsync();
        if (_webhook is not null)
        {
            _webhookUrl = _webhook.Url;
            _webhookEvents = _webhook.Events.ToHashSet();
            _webhookEnabled = _webhook.Enabled;
        }
        await LoadAudioSettingsAsync();

        if (Auth.CurrentUser?.Role == "admin")
        {
            _connections = await Api.GetConnectionsAsync();
            if (_connections is not null)
            {
                _ollamaRows = _connections.OllamaBaseUrls
                    .Select((url, i) => new ConnectionRow
                    {
                        Url = url,
                        Name = _connections.OllamaNames?.ElementAtOrDefault(i) ?? string.Empty,
                    })
                    .ToList();
                _openAiRows = _connections.OpenAiBaseUrls
                    .Select((url, i) => new ConnectionRow
                    {
                        Url = url,
                        Name = _connections.OpenAiNames?.ElementAtOrDefault(i) ?? string.Empty,
                        KeyConfigured = _connections.OpenAiKeyConfigured.ElementAtOrDefault(i),
                    })
                    .ToList();
            }

            var adminConfig = await Api.GetAdminConfigAsync();
            await LoadOllamaModelsAsync();
            if (adminConfig is not null)
            {
                _adminWebUiName = adminConfig.WebUiName;
                _adminDefaultRole = adminConfig.DefaultUserRole;
                _adminEnableSignup = adminConfig.EnableSignup;
                _adminEnableLoginForm = adminConfig.EnableLoginForm;
                _adminEnableApiKeys = adminConfig.EnableApiKeys;
                _adminEnableRating = adminConfig.EnableMessageRating;
                _adminEnableFolders = adminConfig.EnableFolders;
                _adminEnableMemories = adminConfig.EnableMemories;

                _capabilities = await Api.GetDetectedCapabilitiesAsync();

                var images = await Api.GetImagesConfigAsync();
                if (images is not null)
                {
                    _imagesEnabled = images.Enabled;
                    _imagesEngine = images.Engine;
                    _imagesBaseUrl = images.BaseUrl;
                    _imagesApiKey = string.Empty;
                    _imagesModel = images.Model;
                    _imagesSize = images.Size;
                    _imagesEngineParams = images.EngineParams;
                }

                var video = await Api.GetVideoConfigAsync();
                if (video is not null)
                {
                    _videoEnabled = video.Enabled;
                    _videoEngine = video.Engine;
                    _videoBaseUrl = video.BaseUrl;
                    _videoApiKey = string.Empty;
                    _videoModel = video.Model;
                    _videoSize = video.Size;
                    _videoEngineParams = video.EngineParams;
                }
                _videoEngines = await Api.GetVideoEnginesAsync();

                var audio = await Api.GetAudioConfigAsync();
                if (audio is not null)
                {
                    _ttsEngine = audio.TtsEngine;
                    _ttsProvider = audio.TtsProvider ?? string.Empty;
                    _ttsBaseUrl = audio.TtsBaseUrl ?? string.Empty;
                    _ttsModel = audio.TtsModel ?? string.Empty;
                    _ttsVoice = audio.TtsVoice ?? "alloy";
                    _sttEngine = audio.SttEngine;
                    _sttProvider = audio.SttProvider ?? string.Empty;
                    _sttBaseUrl = audio.SttBaseUrl ?? string.Empty;
                    _sttModel = audio.SttModel ?? string.Empty;
                }

                _adminWebhook = await Api.GetAdminWebhookAsync();
                if (_adminWebhook is not null)
                {
                    _adminWebhookUrl = _adminWebhook.Url;
                    _adminWebhookEvents = _adminWebhook.Events.ToHashSet();
                    _adminWebhookEnabled = _adminWebhook.Enabled;
                }

                _adminLoaded = true;
            }
        }
    }

