    /// <summary>Opções do combo: modelos detectados + valor atual caso ausente.</summary>
    private static IEnumerable<string> ModelOptions(
        IReadOnlyList<string> detected, string current)
    {
        if (!string.IsNullOrWhiteSpace(current) && !detected.Contains(current))
        {
            yield return current;
        }
        foreach (var m in detected)
        {
            yield return m;
        }
    }

    /// <summary>URLs das conexões cadastradas + base detectada + valor atual.</summary>
    private IEnumerable<string> ProviderOptions(string? detectedBase, string current)
    {
        var urls = _connections?.OpenAiBaseUrls ?? (IReadOnlyList<string>)[];
        foreach (var url in urls.Where(u => !string.IsNullOrWhiteSpace(u)))
        {
            yield return url.TrimEnd('/');
        }
        if (!string.IsNullOrWhiteSpace(detectedBase) && !urls.Contains(detectedBase))
        {
            yield return detectedBase;
        }
        if (!string.IsNullOrWhiteSpace(current) && !urls.Contains(current)
            && current != detectedBase)
        {
            yield return current;
        }
    }

