    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_focusTrapped)
        {
            _focusTrapped = true;
            await JS.InvokeVoidAsync("openwebui.trapFocus", _modalElement);
        }
        else if (!IsOpen && _focusTrapped)
        {
            _focusTrapped = false;
            await JS.InvokeVoidAsync("openwebui.releaseFocus", _modalElement);
        }
    }

