@inject ApiService Api
@inject AuthService Auth
@inject ThemeService Theme
@inject LocalizationService L
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <span>@L["settings.title"]</span>
                <button class="icon-btn" @onclick="Close">×</button>
            </div>

            <div class="modal-tabs">
                <button class="modal-tab @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>@L["settings.general"]</button>
                <button class="modal-tab @(_tab == "account" ? "active" : "")" @onclick='() => _tab = "account"'>@L["settings.account"]</button>
                <button class="modal-tab @(_tab == "memories" ? "active" : "")" @onclick='() => _tab = "memories"'>@L["settings.memories"]</button>
                @if (Auth.CurrentUser?.Role == "admin")
                {
                    <button class="modal-tab @(_tab == "connections" ? "active" : "")" @onclick='() => _tab = "connections"'>@L["settings.connections"]</button>
                    <button class="modal-tab @(_tab == "admin" ? "active" : "")" @onclick='() => _tab = "admin"'>@L["settings.admin"]</button>
                }
                <button class="modal-tab @(_tab == "about" ? "active" : "")" @onclick='() => _tab = "about"'>@L["settings.about"]</button>
            </div>

            <div class="modal-body">
                @if (_tab == "general")
                {
                    <div class="field">
                        <label>@L["settings.theme"]</label>
                        <select class="input" value="@Theme.Current" @onchange="OnThemeChanged">
                            <option value="dark">@L["settings.theme_dark"]</option>
                            <option value="light">@L["settings.theme_light"]</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>@L["settings.language"]</label>
                        <select class="input" value="@L.Language" @onchange="OnLanguageChanged">
                            @foreach (var (lang, display) in LocalizationService.Languages)
                            {
                                <option value="@lang">@display</option>
                            }
                        </select>
                    </div>
                    @if (_ttsSupported || _sttSupported)
                    {
                        <div class="field">
                            <label>@L["settings.audio_engine"]</label>
                            <select class="input" value="@_audioEngine" @onchange="OnAudioEngineChanged">
                                <option value="auto">@L["settings.audio_engine_auto"]</option>
                                <option value="web-speech">Web Speech</option>
                                <option value="server">@L["settings.audio_engine_server"]</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>@L["settings.audio_voice"]</label>
                            <select class="input" value="@_audioVoice" @onchange="OnAudioVoiceChanged" disabled="@(!_ttsSupported)">
                                <option value="">@L["settings.audio_voice_default"]</option>
                                @foreach (var v in _audioVoices)
                                {
                                    <option value="@v.Name">@v.Name (@v.Lang)</option>
                                }
                            </select>
                        </div>
                        <label class="check"><input type="checkbox" checked="@_audioAutoSend" @onchange="OnAutoSendChanged" disabled="@(!_sttSupported)" /> @L["settings.audio_autosend"]</label>
                    }
                }
                else if (_tab == "account")
                {
                    <div class="field">
                        <label>@L["common.name"]</label>
                        <input class="input" @bind="_name" />
                    </div>
                    <div class="field">
                        <label>@L["settings.profile_url"]</label>
                        <input class="input" @bind="_profileImage" placeholder="https://…" />
                    </div>
                    <button class="auth-submit" @onclick="SaveProfileAsync">@L["settings.save_profile"]</button>

                    <hr class="modal-sep" />

                    <div class="field">
                        <label>@L["settings.current_password"]</label>
                        <input class="input" type="password" @bind="_currentPassword" />
                    </div>
                    <div class="field">
                        <label>@L["settings.new_password"]</label>
                        <input class="input" type="password" @bind="_newPassword" />
                    </div>
                    <button class="auth-submit" @onclick="ChangePasswordAsync">@L["settings.change_password"]</button>

                    <hr class="modal-sep" />

                    <div class="field">
                        <label>@L["settings.api_key"]</label>
                        @if (_apiKeyCreated is not null)
                        {
                            <input class="input" readonly value="@_apiKeyCreated" />
                            <div class="field-note">@L["settings.api_key_copy_now"]</div>
                        }
                        else if (_apiKeyInfo is not null)
                        {
                            <div class="field-note">@L.T("settings.api_key_active_since", ("date", FormatDate(_apiKeyInfo.CreatedAt)))</div>
                        }
                        else
                        {
                            <div class="field-note">@L["settings.api_key_none"]</div>
                        }
                        <div class="field-actions">
                            <button class="msg-action" @onclick="CreateApiKeyAsync">@L["settings.generate_key"]</button>
                            @if (_apiKeyInfo is not null || _apiKeyCreated is not null)
                            {
                                <button class="msg-action" @onclick="RevokeApiKeyAsync">@L["settings.revoke"]</button>
                            }
                        </div>
                    </div>

                    @if (_accountMessage is not null)
                    {
                        <div class="field-note">@_accountMessage</div>
                    }
                }
                else if (_tab == "memories")
                {
                    <div class="field">
                        <label>@L["settings.memories_label"]</label>
                        @if (_memories.Count == 0)
                        {
                            <div class="field-note">@L["settings.memories_empty"]</div>
                        }
                        @foreach (var memory in _memories)
                        {
                            <div class="memory-row">
                                <span class="memory-text">@memory.Content</span>
                                <button class="icon-mini" @onclick="() => DeleteMemoryAsync(memory)">×</button>
                            </div>
                        }
                    </div>
                    <div class="field">
                        <label>@L["settings.add_memory"]</label>
                        <input class="input" @bind="_newMemory" placeholder="@L["settings.add_memory_placeholder"]" />
                    </div>
                    <button class="auth-submit" disabled="@string.IsNullOrWhiteSpace(_newMemory)"
                            @onclick="AddMemoryAsync">@L["settings.add"]</button>
                }
                else if (_tab == "connections")
                {
                    @if (_connections is null)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else
                    {
                        <div class="field">
                            <label>@L["settings.ollama_urls"]</label>
                            <textarea class="input" rows="2" @bind="_ollamaUrls"></textarea>
                        </div>
                        <div class="field">
                            <label>@L["settings.openai_urls"]</label>
                            <textarea class="input" rows="2" @bind="_openAiUrls"></textarea>
                        </div>
                        <div class="field">
                            <label>@L["settings.openai_keys"]</label>
                            <textarea class="input" rows="2" @bind="_openAiKeys" placeholder="@L["settings.keys_keep"]"></textarea>
                        </div>
                        @if (_saveMessage is not null)
                        {
                            <div class="field-note">@_saveMessage</div>
                        }
                        <button class="auth-submit" @onclick="SaveConnectionsAsync">@L["common.save"]</button>
                    }
                }
                else if (_tab == "admin")
                {
                    @if (!_adminLoaded)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else
                    {
                        <div class="field">
                            <label>@L["settings.instance_name"]</label>
                            <input class="input" @bind="_adminWebUiName" />
                        </div>
                        <div class="field">
                            <label>@L["settings.default_role"]</label>
                            <select class="input" @bind="_adminDefaultRole">
                                <option value="pending">@L["settings.role_pending"]</option>
                                <option value="user">@L["settings.role_user"]</option>
                                <option value="admin">@L["settings.role_admin"]</option>
                            </select>
                        </div>
                        <label class="check"><input type="checkbox" @bind="_adminEnableSignup" /> @L["settings.allow_signup"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableLoginForm" /> @L["settings.allow_password_login"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableApiKeys" /> @L["settings.allow_api_keys"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableRating" /> @L["settings.enable_rating"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableFolders" /> @L["settings.enable_folders"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableMemories" /> @L["settings.enable_memories"]</label>

                        <div class="field"><strong>@L["settings.images_section"]</strong></div>
                        <label class="check"><input type="checkbox" @bind="_imagesEnabled" /> @L["settings.images_enabled"]</label>
                        @if (_imagesEnabled)
                        {
                            <div class="field">
                                <label>@L["settings.images_base_url"]</label>
                                <input class="input" @bind="_imagesBaseUrl" placeholder="https://api.openai.com/v1" />
                            </div>
                            <div class="field">
                                <label>@L["settings.images_api_key"]</label>
                                <input class="input" type="password" @bind="_imagesApiKey" placeholder="@L["settings.keys_keep"]" />
                            </div>
                            <div class="field">
                                <label>@L["settings.images_model"]</label>
                                <input class="input" @bind="_imagesModel" placeholder="gpt-image-1" />
                            </div>
                            <div class="field">
                                <label>@L["settings.images_size"]</label>
                                <select class="input" @bind="_imagesSize">
                                    <option value="1024x1024">1024x1024</option>
                                    <option value="1024x1792">1024x1792</option>
                                    <option value="1792x1024">1792x1024</option>
                                    <option value="512x512">512x512</option>
                                    <option value="auto">auto</option>
                                </select>
                            </div>
                        }
                        @if (_adminMessage is not null)
                        {
                            <div class="field-note">@_adminMessage</div>
                        }
                        <button class="auth-submit" @onclick="SaveAdminAsync">@L["common.save"]</button>
                    }
                }
                else
                {
                    <div class="field">
                        <label>@L["settings.backend_version"]</label>
                        <div>@(_version ?? "…")</div>
                    </div>
                    <div class="field">
                        <label>Stack</label>
                        <div>.NET 10 · C# 14 · Blazor WebAssembly</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Controla a visibilidade do modal.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Disparado quando o modal é fechado.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private string _tab = "general";
    private ConnectionsConfigResponse? _connections;
    private string _ollamaUrls = string.Empty;
    private string _openAiUrls = string.Empty;
    private string _openAiKeys = string.Empty;
    private string? _saveMessage;
    private string? _version;

    private string _name = string.Empty;
    private string _profileImage = string.Empty;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _apiKeyCreated;
    private ApiKeyInfoResponse? _apiKeyInfo;
    private string? _accountMessage;

    private List<MemoryResponse> _memories = [];
    private string _newMemory = string.Empty;

    private bool _adminLoaded;
    private string _adminWebUiName = "Open WebUI";
    private string _adminDefaultRole = "pending";
    private bool _adminEnableSignup = true;
    private bool _adminEnableLoginForm = true;
    private bool _adminEnableApiKeys = true;
    private bool _adminEnableRating = true;
    private bool _adminEnableFolders = true;
    private bool _adminEnableMemories;
    private bool _imagesEnabled;
    private string _imagesBaseUrl = "https://api.openai.com/v1";
    private string _imagesApiKey = string.Empty;
    private string _imagesModel = "gpt-image-1";
    private string _imagesSize = "1024x1024";
    private string? _adminMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!IsOpen)
        {
            return;
        }

        _version = (await Api.GetVersionAsync())?.Version;
        _name = Auth.CurrentUser?.Name ?? string.Empty;
        _profileImage = Auth.CurrentUser?.ProfileImageUrl ?? string.Empty;
        _apiKeyInfo = await Api.GetApiKeyAsync();
        _memories = await Api.GetMemoriesAsync();
        await LoadAudioSettingsAsync();

        if (Auth.CurrentUser?.Role == "admin")
        {
            _connections = await Api.GetConnectionsAsync();
            if (_connections is not null)
            {
                _ollamaUrls = string.Join('\n', _connections.OllamaBaseUrls);
                _openAiUrls = string.Join('\n', _connections.OpenAiBaseUrls);
                _openAiKeys = string.Empty;
            }

            var adminConfig = await Api.GetAdminConfigAsync();
            if (adminConfig is not null)
            {
                _adminWebUiName = adminConfig.WebUiName;
                _adminDefaultRole = adminConfig.DefaultUserRole;
                _adminEnableSignup = adminConfig.EnableSignup;
                _adminEnableLoginForm = adminConfig.EnableLoginForm;
                _adminEnableApiKeys = adminConfig.EnableApiKeys;
                _adminEnableRating = adminConfig.EnableMessageRating;
                _adminEnableFolders = adminConfig.EnableFolders;
                _adminEnableMemories = adminConfig.EnableMemories;

                var images = await Api.GetImagesConfigAsync();
                if (images is not null)
                {
                    _imagesEnabled = images.Enabled;
                    _imagesBaseUrl = images.BaseUrl;
                    _imagesApiKey = string.Empty;
                    _imagesModel = images.Model;
                    _imagesSize = images.Size;
                }

                _adminLoaded = true;
            }
        }
    }

    private async Task OnThemeChanged(ChangeEventArgs e)
    {
        if (e.Value is string theme)
        {
            await Theme.SetAsync(theme);
        }
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        if (e.Value is string language)
        {
            await L.SetLanguageAsync(language);
        }
    }

    private bool _ttsSupported;
    private bool _sttSupported;
    private bool _audioAutoSend;
    private string _audioVoice = string.Empty;
    private string _audioEngine = "auto";
    private List<VoiceInfo> _audioVoices = [];

    private sealed record VoiceInfo(string Name, string Lang);

    private async Task LoadAudioSettingsAsync()
    {
        _ttsSupported = await JS.InvokeAsync<bool>("openwebui.audio.ttsSupported");
        _sttSupported = await JS.InvokeAsync<bool>("openwebui.audio.sttSupported");
        if (!_ttsSupported && !_sttSupported)
        {
            return;
        }

        _audioVoice = await JS.InvokeAsync<string>("openwebui.audio.getVoice");
        _audioEngine = await JS.InvokeAsync<string>("openwebui.audio.getEngine");
        _audioAutoSend = await JS.InvokeAsync<bool>("openwebui.audio.getAutoSend");
        _audioVoices = await JS.InvokeAsync<List<VoiceInfo>>("openwebui.audio.voices");
    }

    private async Task OnAudioEngineChanged(ChangeEventArgs e)
    {
        _audioEngine = e.Value as string ?? "auto";
        await JS.InvokeVoidAsync("openwebui.audio.setEngine", _audioEngine);
        _ttsSupported = await JS.InvokeAsync<bool>("openwebui.audio.ttsSupported");
        _sttSupported = await JS.InvokeAsync<bool>("openwebui.audio.sttSupported");
    }

    private async Task OnAudioVoiceChanged(ChangeEventArgs e)
    {
        _audioVoice = e.Value as string ?? string.Empty;
        await JS.InvokeVoidAsync("openwebui.audio.setVoice", _audioVoice);
    }

    private async Task OnAutoSendChanged(ChangeEventArgs e)
    {
        _audioAutoSend = e.Value is true;
        await JS.InvokeVoidAsync("openwebui.audio.setAutoSend", _audioAutoSend);
    }

    private async Task SaveProfileAsync()
    {
        var user = await Api.UpdateProfileAsync(_name.Trim(), _profileImage.Trim());
        if (user is not null)
        {
            await Auth.RefreshUserAsync();
            _accountMessage = L["settings.profile_saved"];
        }
        else
        {
            _accountMessage = L["settings.profile_failed"];
        }
    }

    private async Task ChangePasswordAsync()
    {
        var ok = await Api.UpdatePasswordAsync(_currentPassword, _newPassword);
        _accountMessage = ok ? L["settings.password_changed"] : L["settings.password_failed"];
        _currentPassword = string.Empty;
        _newPassword = string.Empty;
    }

    private async Task CreateApiKeyAsync()
    {
        var created = await Api.CreateApiKeyAsync();
        _apiKeyCreated = created?.ApiKey;
    }

    private async Task RevokeApiKeyAsync()
    {
        await Api.DeleteApiKeyAsync();
        _apiKeyCreated = null;
        _apiKeyInfo = null;
    }

    private async Task AddMemoryAsync()
    {
        var added = await Api.AddMemoryAsync(_newMemory.Trim());
        if (added is not null)
        {
            _memories.Add(added);
            _newMemory = string.Empty;
        }
    }

    private async Task DeleteMemoryAsync(MemoryResponse memory)
    {
        if (await Api.DeleteMemoryAsync(memory.Id))
        {
            _memories.Remove(memory);
        }
    }

    private async Task SaveConnectionsAsync()
    {
        var ollama = SplitLines(_ollamaUrls);
        var openAi = SplitLines(_openAiUrls);
        var keys = SplitLines(_openAiKeys);

        // Chaves deixadas em branco são preservadas pelo servidor.
        while (keys.Count < openAi.Count)
        {
            keys.Add(string.Empty);
        }

        var result = await Api.UpdateConnectionsAsync(
            new ConnectionsConfig(ollama, openAi, keys));
        _saveMessage = result is null ? L["settings.save_failed"] : L["settings.saved"];
        _connections = result;
    }

    private async Task SaveAdminAsync()
    {
        var result = await Api.UpdateAdminConfigAsync(new AdminConfig(
            _adminEnableSignup,
            _adminEnableLoginForm,
            _adminEnableApiKeys,
            _adminDefaultRole,
            _adminEnableRating,
            _adminEnableFolders,
            _adminEnableMemories,
            _adminWebUiName.Trim()));
        var images = await Api.UpdateImagesConfigAsync(new ImagesConfig(
            _imagesEnabled,
            "openai",
            _imagesBaseUrl.Trim(),
            _imagesApiKey.Trim(),
            _imagesModel.Trim(),
            _imagesSize,
            120));
        _adminMessage = result is null || images is null
            ? L["settings.save_failed"]
            : L["settings.admin_saved"];
    }

    private static string FormatDate(long unixSeconds) =>
        DateTimeOffset.FromUnixTimeSeconds(unixSeconds).ToString("dd/MM/yyyy");

    private static List<string> SplitLines(string text) =>
        text.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .ToList();

    private Task Close() => OnClose.InvokeAsync();
}
