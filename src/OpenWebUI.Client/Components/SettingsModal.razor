@inject ApiService Api
@inject AuthService Auth
@inject ThemeService Theme
@inject LocalizationService L
@inject IJSRuntime JS
@inject ChatNotificationsService ChatNotify

@if (IsOpen)
{
    <div class="modal-backdrop" @onclick="Close">
        <div class="modal" role="dialog" aria-modal="true" aria-label="@L["settings.title"]"
             tabindex="-1" @ref="_modalElement" @onkeydown="OnKeyDown" @onclick:stopPropagation>
            <div class="modal-header">
                <span>@L["settings.title"]</span>
                <button class="icon-btn" aria-label="@L["common.close"]" @onclick="Close">×</button>
            </div>

            <div class="modal-shell">
                <div class="modal-tabs">
                    <button class="modal-tab @(_tab == "general" ? "active" : "")" @onclick='() => _tab = "general"'>@L["settings.general"]</button>
                    <button class="modal-tab @(_tab == "account" ? "active" : "")" @onclick='() => _tab = "account"'>@L["settings.account"]</button>
                    <button class="modal-tab @(_tab == "memories" ? "active" : "")" @onclick='() => _tab = "memories"'>@L["settings.memories"]</button>
                    <button class="modal-tab @(_tab == "notifications" ? "active" : "")" @onclick='() => SelectTab("notifications")'>@L["settings.notifications"]</button>
                    @if (Auth.CurrentUser?.Role == "admin")
                    {
                        <button class="modal-tab @(_tab == "connections" ? "active" : "")" @onclick='() => _tab = "connections"'>@L["settings.connections"]</button>
                        <button class="modal-tab @(_tab == "admin" ? "active" : "")" @onclick='() => _tab = "admin"'>@L["settings.admin"]</button>
                    }
                    <button class="modal-tab @(_tab == "about" ? "active" : "")" @onclick='() => _tab = "about"'>@L["settings.about"]</button>
                </div>

                <div class="modal-body">
                @if (_tab == "general")
                {
                    <div class="field">
                        <label>@L["settings.theme"]</label>
                        <select class="input" value="@Theme.Current" @onchange="OnThemeChanged">
                            <option value="system">@L["settings.theme_system"]</option>
                            <option value="dark">@L["settings.theme_dark"]</option>
                            <option value="light">@L["settings.theme_light"]</option>
                        </select>
                    </div>
                    <div class="field">
                        <label>@L["settings.language"]</label>
                        <select class="input" value="@L.Language" @onchange="OnLanguageChanged">
                            @foreach (var (lang, display) in L.Languages)
                            {
                                <option value="@lang">@display</option>
                            }
                        </select>
                    </div>
                    @if (_ttsSupported || _sttSupported)
                    {
                        <div class="field">
                            <label>@L["settings.audio_engine"]</label>
                            <select class="input" value="@_audioEngine" @onchange="OnAudioEngineChanged">
                                <option value="auto">@L["settings.audio_engine_auto"]</option>
                                <option value="web-speech">Web Speech</option>
                                <option value="server">@L["settings.audio_engine_server"]</option>
                            </select>
                        </div>
                        <div class="field">
                            <label>@L["settings.audio_voice"]</label>
                            <select class="input" value="@_audioVoice" @onchange="OnAudioVoiceChanged" disabled="@(!_ttsSupported)">
                                <option value="">@L["settings.audio_voice_default"]</option>
                                @foreach (var v in _audioVoices)
                                {
                                    <option value="@v.Name">@v.Name (@v.Lang)</option>
                                }
                            </select>
                        </div>
                        <label class="check"><input type="checkbox" checked="@_audioAutoSend" @onchange="OnAutoSendChanged" disabled="@(!_sttSupported)" /> @L["settings.audio_autosend"]</label>
                    }
                }
                else if (_tab == "account")
                {
                    <div class="field">
                        <label>@L["common.name"]</label>
                        <input class="input" @bind="_name" />
                    </div>
                    <div class="field">
                        <label>@L["settings.profile_url"]</label>
                        <input class="input" @bind="_profileImage" placeholder="https://…" />
                    </div>
                    <button class="auth-submit" @onclick="SaveProfileAsync">@L["settings.save_profile"]</button>

                    <hr class="modal-sep" />

                    <div class="field">
                        <label>@L["settings.current_password"]</label>
                        <input class="input" type="password" @bind="_currentPassword" />
                    </div>
                    <div class="field">
                        <label>@L["settings.new_password"]</label>
                        <input class="input" type="password" @bind="_newPassword" />
                    </div>
                    <button class="auth-submit" @onclick="ChangePasswordAsync">@L["settings.change_password"]</button>

                    <hr class="modal-sep" />

                    <div class="field">
                        <label>@L["settings.api_key"]</label>
                        @if (_apiKeyCreated is not null)
                        {
                            <input class="input" readonly value="@_apiKeyCreated" />
                            <div class="field-note">@L["settings.api_key_copy_now"]</div>
                        }
                        else if (_apiKeyInfo is not null)
                        {
                            <div class="field-note">@L.T("settings.api_key_active_since", ("date", FormatDate(_apiKeyInfo.CreatedAt)))</div>
                        }
                        else
                        {
                            <div class="field-note">@L["settings.api_key_none"]</div>
                        }
                        <div class="field-actions">
                            <button class="msg-action" @onclick="CreateApiKeyAsync">@L["settings.generate_key"]</button>
                            @if (_apiKeyInfo is not null || _apiKeyCreated is not null)
                            {
                                <button class="msg-action" @onclick="RevokeApiKeyAsync">@L["settings.revoke"]</button>
                            }
                        </div>
                    </div>

                    <hr class="modal-sep" />

                    <div class="field">
                        <label>@L["settings.webhook_url"]</label>
                        <input class="input" @bind="_webhookUrl" placeholder="https://…" />
                    </div>
                    <div class="field">
                        <label>@L["settings.webhook_events"]</label>
                        @foreach (var ev in WebhookEvents)
                        {
                            <label class="check"><input type="checkbox" checked="@_webhookEvents.Contains(ev)" @onchange="e => ToggleWebhookEvent(ev, e)" /> @ev</label>
                        }
                    </div>
                    <label class="check"><input type="checkbox" @bind="_webhookEnabled" /> @L["settings.webhook_enabled"]</label>
                    <div class="field-actions">
                        <button class="msg-action" @onclick="SaveWebhookAsync">@L["common.save"]</button>
                        <button class="msg-action" @onclick="TestWebhookAsync" disabled="@string.IsNullOrWhiteSpace(_webhookUrl)">@L["settings.webhook_test"]</button>
                        <button class="msg-action" @onclick="DeleteWebhookAsync" disabled="@(_webhook is null)">@L["settings.webhook_remove"]</button>
                    </div>
                    @if (_webhookMessage is not null)
                    {
                        <div class="field-note">@_webhookMessage</div>
                    }

                    @if (_accountMessage is not null)
                    {
                        <div class="field-note">@_accountMessage</div>
                    }
                }
                else if (_tab == "memories")
                {
                    <div class="field">
                        <label>@L["settings.memories_label"]</label>
                        @if (_memories.Count == 0)
                        {
                            <div class="field-note">@L["settings.memories_empty"]</div>
                        }
                        @foreach (var memory in _memories)
                        {
                            <div class="memory-row">
                                <span class="memory-text">@memory.Content</span>
                                <button class="icon-mini" @onclick="() => DeleteMemoryAsync(memory)">×</button>
                            </div>
                        }
                    </div>
                    <div class="field">
                        <label>@L["settings.add_memory"]</label>
                        <input class="input" @bind="_newMemory" placeholder="@L["settings.add_memory_placeholder"]" />
                    </div>
                    <button class="auth-submit" disabled="@string.IsNullOrWhiteSpace(_newMemory)"
                            @onclick="AddMemoryAsync">@L["settings.add"]</button>
                }
                else if (_tab == "notifications")
                {
                    <label class="check">
                        <input type="checkbox" checked="@_notifyChatDone" @onchange="OnNotifyChatDoneChanged" />
                        @L["settings.notify_chat_done"]
                    </label>
                    <label class="check">
                        <input type="checkbox" checked="@_notifyBrowser" @onchange="OnNotifyBrowserChanged" />
                        @L["settings.notify_browser"]
                    </label>
                    <label class="check">
                        <input type="checkbox" checked="@_notifyPush" @onchange="OnNotifyPushChanged" />
                        @L["settings.notify_push"]
                    </label>
                    @if (_notifyPermission is "denied" or "unsupported")
                    {
                        <p class="hint text-red-600 dark:text-red-400">
                            @L[_notifyPermission == "denied"
                                ? "settings.notify_permission_denied"
                                : "settings.notify_permission_unsupported"]
                        </p>
                    }
                    <p class="hint">@L["settings.notify_hint"]</p>
                }
                else if (_tab == "connections")
                {
                    @if (_connections is null)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else
                    {
                        <div class="field">
                            <label>@L["settings.ollama_connections"]</label>
                            @foreach (var row in _ollamaRows)
                            {
                                <div class="flex gap-2 mb-1 items-center">
                                    <input class="input w-40" @bind="row.Name" placeholder="@L["common.name"]" />
                                    <input class="input flex-1" @bind="row.Url" placeholder="http://localhost:11434" />
                                    <button class="msg-action danger flex-none" @onclick="() => _ollamaRows.Remove(row)">✕</button>
                                </div>
                            }
                            <button class="button-sm" @onclick="() => _ollamaRows.Add(new ConnectionRow())">@L["settings.add_connection"]</button>
                        </div>
                        <div class="field">
                            <label>@L["settings.openai_connections"]</label>
                            @foreach (var row in _openAiRows)
                            {
                                <div class="flex gap-2 mb-1 items-center">
                                    <input class="input w-40" @bind="row.Name" placeholder="@L["common.name"]" />
                                    <input class="input flex-1" @bind="row.Url" placeholder="https://api.openai.com/v1" />
                                    <input class="input w-48" type="password" @bind="row.Key"
                                           placeholder="@(row.KeyConfigured ? L["settings.keys_keep"] : "API key")" />
                                    <button class="msg-action danger flex-none" @onclick="() => _openAiRows.Remove(row)">✕</button>
                                </div>
                            }
                            <button class="button-sm" @onclick="() => _openAiRows.Add(new ConnectionRow())">@L["settings.add_connection"]</button>
                        </div>
                        @if (_saveMessage is not null)
                        {
                            <div class="field-note">@_saveMessage</div>
                        }
                        <button class="auth-submit" @onclick="SaveConnectionsAsync">@L["common.save"]</button>

                        @if (Auth.CurrentUser?.Role == "admin")
                        {
                            <hr />
                            <div class="field">
                                <label>@L["settings.ollama_models"]</label>
                                @if (_ollamaModels is null)
                                {
                                    <div class="field-note">@L["common.loading"]</div>
                                }
                                else if (_ollamaModels.Count == 0)
                                {
                                    <div class="field-note">@L["settings.no_ollama_models"]</div>
                                }
                                else
                                {
                                    @foreach (var model in _ollamaModels)
                                    {
                                        <div class="field" style="display:flex;align-items:center;justify-content:space-between">
                                            <span>@model.Name</span>
                                            <button class="button-sm" @onclick="() => DeleteOllamaModelAsync(model)">@L["common.delete"]</button>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="field">
                                <input class="input" @bind="_ollamaPullName"
                                       placeholder="@L["settings.pull_model_placeholder"]" />
                            </div>
                            @if (_ollamaPullMessage is not null)
                            {
                                <div class="field-note">@_ollamaPullMessage</div>
                            }
                            <button class="auth-submit" disabled="@(_ollamaPulling || string.IsNullOrWhiteSpace(_ollamaPullName))"
                                    @onclick="PullOllamaModelAsync">
                                @(_ollamaPulling ? L["settings.pulling"] : L["settings.pull_model"])</button>
                        }
                    }
                }
                else if (_tab == "admin")
                {
                    @if (!_adminLoaded)
                    {
                        <div>@L["common.loading"]</div>
                    }
                    else
                    {
                        <div class="field">
                            <label>@L["settings.instance_name"]</label>
                            <input class="input" @bind="_adminWebUiName" />
                        </div>
                        <div class="field">
                            <label>@L["settings.default_role"]</label>
                            <select class="input" @bind="_adminDefaultRole">
                                <option value="pending">@L["settings.role_pending"]</option>
                                <option value="user">@L["settings.role_user"]</option>
                                <option value="admin">@L["settings.role_admin"]</option>
                            </select>
                        </div>
                        <label class="check"><input type="checkbox" @bind="_adminEnableSignup" /> @L["settings.allow_signup"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableLoginForm" /> @L["settings.allow_password_login"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableApiKeys" /> @L["settings.allow_api_keys"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableRating" /> @L["settings.enable_rating"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableFolders" /> @L["settings.enable_folders"]</label>
                        <label class="check"><input type="checkbox" @bind="_adminEnableMemories" /> @L["settings.enable_memories"]</label>

                        <div class="field"><strong>@L["settings.images_section"]</strong></div>
                        <label class="check"><input type="checkbox" @bind="_imagesEnabled" /> @L["settings.images_enabled"]</label>
                        @if (_imagesEnabled)
                        {
                            <div class="field">
                                <label>@L["settings.images_engine"]</label>
                                <select class="input" @bind="_imagesEngine">
                                    @foreach (var engine in _imageEngines)
                                    {
                                        <option value="@engine">@engine</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>@L["settings.images_base_url"]</label>
                                <input class="input" @bind="_imagesBaseUrl" placeholder="https://api.openai.com/v1" />
                            </div>
                            <div class="field">
                                <label>@L["settings.images_api_key"]</label>
                                <input class="input" type="password" @bind="_imagesApiKey" placeholder="@L["settings.keys_keep"]" />
                            </div>
                            <div class="field">
                                <label>@L["settings.images_model"]</label>
                                @if (_capabilities?.Image.Count > 0)
                                {
                                    <select class="input" @bind="_imagesModel">
                                        @foreach (var m in ModelOptions(_capabilities.Image, _imagesModel))
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="input" @bind="_imagesModel" placeholder="gpt-image-1" />
                                }
                            </div>
                            <div class="field">
                                <label>@L["settings.images_size"]</label>
                                <select class="input" @bind="_imagesSize">
                                    <option value="1024x1024">1024x1024</option>
                                    <option value="1024x1792">1024x1792</option>
                                    <option value="1792x1024">1792x1024</option>
                                    <option value="512x512">512x512</option>
                                    <option value="auto">auto</option>
                                </select>
                            </div>
                            <div class="field">
                                <label>@L["settings.images_engine_params"]</label>
                                <textarea class="input" rows="3" @bind="_imagesEngineParams" placeholder="{}"></textarea>
                            </div>
                            <button class="auth-submit" type="button" @onclick="TestImagesAsync" disabled="@_imagesTesting">
                                @(_imagesTesting ? L["settings.images_testing"] : L["settings.images_test"])
                            </button>
                        }

                        <div class="field"><strong>@L["settings.video_section"]</strong></div>
                        <label class="check"><input type="checkbox" @bind="_videoEnabled" /> @L["settings.video_enabled"]</label>
                        @if (_videoEnabled)
                        {
                            <div class="field">
                                <label>@L["settings.video_engine"]</label>
                                <select class="input" @bind="_videoEngine">
                                    @foreach (var engine in _videoEngines)
                                    {
                                        <option value="@engine">@engine</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label>@L["settings.video_base_url"]</label>
                                <input class="input" @bind="_videoBaseUrl" placeholder="https://api.openai.com/v1" />
                            </div>
                            <div class="field">
                                <label>@L["settings.video_api_key"]</label>
                                <input class="input" type="password" @bind="_videoApiKey" placeholder="@L["settings.keys_keep"]" />
                            </div>
                            <div class="field">
                                <label>@L["settings.video_model"]</label>
                                @if (_capabilities?.Video.Count > 0)
                                {
                                    <select class="input" @bind="_videoModel">
                                        @foreach (var m in ModelOptions(_capabilities.Video, _videoModel))
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="input" @bind="_videoModel" placeholder="sora-2" />
                                }
                            </div>
                            <div class="field">
                                <label>@L["settings.video_size"]</label>
                                <select class="input" @bind="_videoSize">
                                    <option value="1280x720">1280x720</option>
                                    <option value="720x1280">720x1280</option>
                                    <option value="1920x1080">1920x1080</option>
                                    <option value="1080x1920">1080x1920</option>
                                </select>
                            </div>
                            <button class="auth-submit" type="button" @onclick="TestVideoAsync" disabled="@_videoTesting">
                                @(_videoTesting ? L["settings.video_testing"] : L["settings.video_test"])
                            </button>
                        }

                        <div class="field"><strong>@L["settings.audio_admin_section"]</strong></div>
                        <div class="field">
                            <label>@L["settings.audio_tts_engine"]</label>
                            <select class="input" @bind="_ttsEngine">
                                @foreach (var engine in TtsEngines)
                                {
                                    <option value="@engine">@engine</option>
                                }
                            </select>
                        </div>
                        @if (_ttsEngine == "provider")
                        {
                            <div class="field">
                                <label>@L["settings.audio_provider"]</label>
                                <select class="input" @bind="_ttsProvider">
                                    <option value="">—</option>
                                    @foreach (var url in ProviderOptions(_capabilities?.BaseUrl, _ttsProvider))
                                    {
                                        <option value="@url">@url</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_ttsEngine is "openai" or "transformers" or "elevenlabs" or "azure")
                        {
                            <div class="field">
                                <label>@L["settings.audio_tts_base_url"]</label>
                                <input class="input" @bind="_ttsBaseUrl" placeholder="https://api.openai.com/v1" />
                            </div>
                            <div class="field">
                                <label>@L["settings.audio_tts_api_key"]</label>
                                <input class="input" type="password" @bind="_ttsApiKey" placeholder="@L["settings.keys_keep"]" />
                            </div>
                        }
                        @if (_ttsEngine is not "none")
                        {
                            <div class="field">
                                <label>@L["settings.audio_tts_model"]</label>
                                @if (_capabilities?.Tts.Count > 0)
                                {
                                    <select class="input" @bind="_ttsModel">
                                        @foreach (var m in ModelOptions(_capabilities.Tts, _ttsModel))
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="input" @bind="_ttsModel" placeholder="tts-1" />
                                }
                            </div>
                            <div class="field">
                                <label>@L["settings.audio_tts_voice"]</label>
                                <input class="input" @bind="_ttsVoice" placeholder="alloy" />
                            </div>
                            <button class="auth-submit" type="button" @onclick="TestAudioAsync" disabled="@_audioTesting">
                                @(_audioTesting ? L["settings.audio_testing"] : L["settings.audio_test"])
                            </button>
                        }
                        <div class="field">
                            <label>@L["settings.audio_stt_engine"]</label>
                            <select class="input" @bind="_sttEngine">
                                @foreach (var engine in SttEngines)
                                {
                                    <option value="@engine">@engine</option>
                                }
                            </select>
                        </div>
                        @if (_sttEngine == "provider")
                        {
                            <div class="field">
                                <label>@L["settings.audio_provider"]</label>
                                <select class="input" @bind="_sttProvider">
                                    <option value="">—</option>
                                    @foreach (var url in ProviderOptions(_capabilities?.BaseUrl, _sttProvider))
                                    {
                                        <option value="@url">@url</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (_sttEngine is "openai" or "deepgram" or "whisper")
                        {
                            <div class="field">
                                <label>@L["settings.audio_stt_base_url"]</label>
                                <input class="input" @bind="_sttBaseUrl" placeholder="https://api.openai.com/v1" />
                            </div>
                        }
                        @if (_sttEngine is not "none")
                        {
                            <div class="field">
                                <label>@L["settings.audio_stt_model"]</label>
                                @if (_capabilities?.Stt.Count > 0)
                                {
                                    <select class="input" @bind="_sttModel">
                                        @foreach (var m in ModelOptions(_capabilities.Stt, _sttModel))
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="input" @bind="_sttModel" placeholder="whisper-1" />
                                }
                            </div>
                        }
                        <hr class="modal-sep" />
                        <div class="field"><strong>@L["settings.webhook_admin_section"]</strong></div>
                        <div class="field">
                            <label>@L["settings.webhook_url"]</label>
                            <input class="input" @bind="_adminWebhookUrl" placeholder="https://…" />
                        </div>
                        <div class="field">
                            <label>@L["settings.webhook_events"]</label>
                            @foreach (var ev in WebhookEvents)
                            {
                                <label class="check"><input type="checkbox" checked="@_adminWebhookEvents.Contains(ev)" @onchange="e => ToggleAdminWebhookEvent(ev, e)" /> @ev</label>
                            }
                        </div>
                        <label class="check"><input type="checkbox" @bind="_adminWebhookEnabled" /> @L["settings.webhook_enabled"]</label>
                        <div class="field-actions">
                            <button class="msg-action" @onclick="SaveAdminWebhookAsync">@L["common.save"]</button>
                            <button class="msg-action" @onclick="TestAdminWebhookAsync" disabled="@string.IsNullOrWhiteSpace(_adminWebhookUrl)">@L["settings.webhook_test"]</button>
                            <button class="msg-action" @onclick="DeleteAdminWebhookAsync" disabled="@(_adminWebhook is null)">@L["settings.webhook_remove"]</button>
                        </div>
                        @if (_adminWebhookMessage is not null)
                        {
                            <div class="field-note">@_adminWebhookMessage</div>
                        }

                        @if (_adminMessage is not null)
                        {
                            <div class="field-note">@_adminMessage</div>
                        }
                        <button class="auth-submit" @onclick="SaveAdminAsync">@L["common.save"]</button>
                    }
                }
                else
                {
                    <div class="field">
                        <label>@L["settings.backend_version"]</label>
                        <div>@(_version ?? "…")</div>
                    </div>
                    <div class="field">
                        <label>Stack</label>
                        <div>.NET 10 · C# 14 · Blazor WebAssembly</div>
                    </div>
                }
                </div>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>Controla a visibilidade do modal.</summary>
    [Parameter] public bool IsOpen { get; set; }

    /// <summary>Disparado quando o modal é fechado.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    private string _tab = "general";

    private async Task SelectTab(string tab)
    {
        _tab = tab;
        if (tab == "notifications")
        {
            _notifyChatDone = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefInApp, defaultValue: true);
            _notifyBrowser = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefBrowser, defaultValue: false);
            _notifyPush = await ChatNotify.GetPrefAsync(
                ChatNotificationsService.PrefPush, defaultValue: false);
            _notifyPermission = await ChatNotify.BrowserPermissionAsync();
        }
    }

    private async Task OnNotifyChatDoneChanged(ChangeEventArgs e)
    {
        _notifyChatDone = e.Value is true;
        await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefInApp, _notifyChatDone);
    }

    private async Task OnNotifyBrowserChanged(ChangeEventArgs e)
    {
        _notifyBrowser = e.Value is true;
        _notifyPermission = await ChatNotify.SetPrefAsync(
            ChatNotificationsService.PrefBrowser, _notifyBrowser);
        // Permissão negada no browser: o toggle não consegue notificar.
        if (_notifyPermission is "denied" or "unsupported")
        {
            _notifyBrowser = false;
            await ChatNotify.SetPrefAsync(ChatNotificationsService.PrefBrowser, false);
        }
    }

