@page "/notes"
@inject ApiService Api
@inject IJSRuntime JS
@inject LocalizationService L

<PageTitle>@L["page.notes"] — Open WebUI</PageTitle>

<div class="page">
    <div class="page-header">
        <h1 class="page-title">@L["page.notes"]</h1>
        <button class="auth-submit page-new" @onclick="NewNoteAsync">@L["notes.new"]</button>
    </div>
    @if (_notes is null)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else if (_notes.Count == 0)
    {
        <div class="sidebar-empty">@L["notes.empty"]</div>
    }
    else
    {
        <div class="card-list">
            @foreach (var note in _notes)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@note.Title</div>
                        <div class="card-sub card-pre">@note.Content</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" @onclick="() => EditNoteAsync(note)">@L["common.edit"]</button>
                        <button class="msg-action danger" @onclick="() => DeleteNoteAsync(note)">🗑</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<NoteResponse>? _notes;

    protected override async Task OnInitializedAsync()
    {
        _notes = await Api.GetNotesAsync();
    }

    private async Task NewNoteAsync()
    {
        var title = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.title"] + ":", L["notes.untitled"]);
        var content = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.content"] + ":", "");
        if (string.IsNullOrWhiteSpace(title) && string.IsNullOrWhiteSpace(content))
        {
            return;
        }

        var created = await Api.CreateNoteAsync(title ?? L["notes.untitled"], content ?? string.Empty);
        if (created is not null)
        {
            _notes?.Insert(0, created);
        }
    }

    private async Task EditNoteAsync(NoteResponse note)
    {
        var title = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.title"] + ":", note.Title);
        var content = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.content"] + ":", note.Content);
        var updated = await Api.UpdateNoteAsync(note.Id,
            title ?? note.Title, content ?? note.Content);
        if (updated is not null && _notes is not null)
        {
            var index = _notes.FindIndex(n => n.Id == note.Id);
            if (index >= 0)
            {
                _notes[index] = updated;
            }
        }
    }

    private async Task DeleteNoteAsync(NoteResponse note)
    {
        if (await JS.InvokeAsync<bool>("openwebui.confirm", L.T("common.confirm_delete", ("name", note.Title)))
            && await Api.DeleteNoteAsync(note.Id))
        {
            _notes?.Remove(note);
        }
    }
}
