@page "/notes"
@inject ApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L

<PageTitle>@L["page.notes"] — Open WebUI</PageTitle>

<div class="page">
    <div class="page-header">
        <h1 class="page-title">@L["page.notes"]</h1>
        <button class="auth-submit page-new" @onclick='() => Nav.NavigateTo("/notes/new")'>@L["notes.new"]</button>
    </div>
    @if (_notes is null)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else if (_notes.Count == 0)
    {
        <div class="sidebar-empty">@L["notes.empty"]</div>
    }
    else
    {
        <div class="card-list">
            @foreach (var note in _notes)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@note.Title</div>
                        <div class="card-sub card-pre">@note.Content</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" @onclick='() => Nav.NavigateTo($"/notes/{note.Id}")'>@L["common.edit"]</button>
                        <button class="msg-action danger" aria-label="@L["common.delete"]" @onclick="() => DeleteNoteAsync(note)">🗑</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<NoteResponse>? _notes;

    protected override async Task OnInitializedAsync()
    {
        _notes = await Api.GetNotesAsync();
    }

    private async Task DeleteNoteAsync(NoteResponse note)
    {
        if (await JS.InvokeAsync<bool>("openwebui.confirm", L.T("common.confirm_delete", ("name", note.Title)))
            && await Api.DeleteNoteAsync(note.Id))
        {
            _notes?.Remove(note);
        }
    }
}
