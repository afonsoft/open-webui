@page "/archived"
@inject ApiService Api
@inject ChatListState ChatList
@inject IJSRuntime JS

<PageTitle>Arquivadas — Open WebUI</PageTitle>

<div class="page">
    <h1 class="page-title">Conversas arquivadas</h1>
    @if (_chats is null)
    {
        <div class="sidebar-empty">Carregando…</div>
    }
    else if (_chats.Count == 0)
    {
        <div class="sidebar-empty">Nenhuma conversa arquivada.</div>
    }
    else
    {
        <div class="card-list">
            @foreach (var chat in _chats)
            {
                <div class="card-row">
                    <div class="card-main">
                        <div class="card-title">@chat.Title</div>
                        <div class="card-sub">Atualizada em @FormatDate(chat.UpdatedAt)</div>
                    </div>
                    <div class="card-actions">
                        <button class="msg-action" @onclick="() => UnarchiveAsync(chat)">📤 Desarquivar</button>
                        <button class="msg-action danger" @onclick="() => DeleteAsync(chat)">🗑 Excluir</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<ChatSummaryResponse>? _chats;

    protected override async Task OnInitializedAsync()
    {
        _chats = await Api.GetArchivedChatsAsync();
    }

    private async Task UnarchiveAsync(ChatSummaryResponse chat)
    {
        await Api.ToggleArchiveChatAsync(chat.Id);
        _chats?.Remove(chat);
        ChatList.NotifyChanged();
    }

    private async Task DeleteAsync(ChatSummaryResponse chat)
    {
        if (!await JS.InvokeAsync<bool>("openwebui.confirm", $"Excluir \"{chat.Title}\" definitivamente?"))
        {
            return;
        }

        if (await Api.DeleteChatAsync(chat.Id))
        {
            _chats?.Remove(chat);
        }
    }

    private static string FormatDate(long unixSeconds) =>
        DateTimeOffset.FromUnixTimeSeconds(unixSeconds).ToString("dd/MM/yyyy HH:mm");
}
