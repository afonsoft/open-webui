@page "/ide"
@implements IDisposable
@inject ApiService Api
@inject LocalizationService L
@inject NavigationManager Nav
@inject ThemeService Theme
@inject IdeTestRunService TestRun

@* /ide — Web IDE (SPEC-20261009-web-ide-surface): explorer + editor CodeMirror +
   painel direito (Chat/Changes/Terminal/Jobs). Gated pela flag ide.enabled;
   exige repo vinculado (empty-state com CTA de bind). *@

@if (!_ready)
{
    <div class="flex h-full items-center justify-center text-sm text-gray-400">…</div>
}
else if (!_enabled)
{
    <div class="flex h-full flex-col items-center justify-center gap-2 p-6 text-center">
        <p class="text-sm text-gray-500">@L["ide.disabled"]</p>
    </div>
}
else if (_repo is null)
{
    <div class="flex h-full flex-col items-center justify-center gap-3 p-6">
        <h2 class="text-base font-semibold text-gray-900 dark:text-white">@L["ide.title"]</h2>
        <p class="max-w-md text-center text-xs text-gray-500">@L["ide.bind_hint"]</p>
        <div class="w-full max-w-md rounded-lg border border-gray-200 dark:border-gray-800 p-3 text-left">
            <RepoBindingPanel BoundChanged="OnBoundChangedAsync" />
        </div>
    </div>
}
else
{
    <div class="flex h-full min-h-0 flex-col">
        <header class="flex items-center gap-2 border-b border-gray-200 dark:border-gray-800 px-2 py-1">
            <button class="msg-action lg:hidden" aria-label="@L["ide.explorer"]"
                    @onclick="() => _explorerOpen = !_explorerOpen">☰</button>
            <span class="min-w-0 flex-1 truncate text-xs font-medium text-gray-700 dark:text-gray-300">
                @_repo.Repo<span class="text-gray-400">@("@")@_repo.Branch</span>
            </span>
            @if (TestRun.Running)
            {
                @* Chip de run de testes em andamento (SPEC-20261009-ide-mentions-tests RF-004). *@
                <span class="test-running-chip">
                    <span class="inline-block size-2 animate-pulse rounded-full bg-blue-500"></span>@L["ide.tests_running"]
                </span>
            }
            <button class="msg-action" title="@L["ide.run_tests"]" aria-label="@L["ide.run_tests"]"
                    @onclick="RunTestsAsync">▶</button>
            <button class="msg-action" title="@L["common.refresh"]" aria-label="@L["common.refresh"]"
                    @onclick="RefreshSideAsync">⟳</button>
            <button class="msg-action lg:hidden" aria-label="@L["ide.panel"]"
                    @onclick="() => _panelOpen = !_panelOpen">◧</button>
        </header>

        <div class="relative flex flex-1 min-h-0">
            <aside class="@(_explorerOpen ? "" : "hidden ")lg:block w-56 shrink-0 border-r border-gray-200 dark:border-gray-800 max-lg:absolute max-lg:inset-y-0 max-lg:left-0 max-lg:z-30 max-lg:bg-white max-lg:dark:bg-gray-950">
                <IdeExplorer @ref="_explorer" Branch="@_git?.Branch"
                             DirtyCount="@(_git?.Files.Count ?? 0)"
                             OnOpenFile="OnOpenFileAsync" OnChanged="RefreshSideAsync" />
            </aside>

            <main class="min-w-0 flex-1">
                <IdeEditor @ref="_editor" Dark="_dark" OnSaved="RefreshSideAsync" />
            </main>

            <aside class="@(_panelOpen ? "" : "hidden ")lg:block w-72 shrink-0 border-l border-gray-200 dark:border-gray-800 max-lg:absolute max-lg:inset-y-0 max-lg:right-0 max-lg:z-30 max-lg:bg-white max-lg:dark:bg-gray-950">
                <IdeRightPanel Git="_git" Jobs="_jobs" Checkpoints="_checkpoints"
                               ActiveFile="@_activePath" OnChanged="RefreshSideAsync" />
            </aside>
        </div>
    </div>
}

@code {
    private bool _ready;
    private bool _enabled;
    private WorkspaceRepoResponse? _repo;
    private WorkspaceGitResponse? _git;
    private List<ChatJobResponse> _jobs = [];
    private IReadOnlyList<WorkspaceCheckpointItem> _checkpoints = [];
    private IdeExplorer? _explorer;
    private IdeEditor? _editor;
    private string? _activePath;
    private bool _explorerOpen;
    private bool _panelOpen;
    private bool _dark;
    private Timer? _poll;

    /// <inheritdoc/>
    protected override async Task OnInitializedAsync()
    {
        _enabled = await Api.GetIdeEnabledAsync();
        if (!_enabled)
        {
            _ready = true;
            return;
        }
        _repo = await Api.GetWorkspaceRepoAsync();
        _ready = true;
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // _repo pode chegar depois do primeiro render (empty-state → bind):
        // inicia o polling na primeira render em que existir repo vinculado.
        if (_repo is not null && _poll is null)
        {
            _dark = Theme.Current == "dark";
            await RefreshSideAsync();
            _poll = new Timer(_ => _ = RefreshSideAsync(), null,
                TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private Task OnBoundChangedAsync(WorkspaceRepoResponse? bound) => ReloadAsync();

    private async Task ReloadAsync()
    {
        _repo = await Api.GetWorkspaceRepoAsync();
        _dark = Theme.Current == "dark";
        await RefreshSideAsync();
    }

    private async Task OnOpenFileAsync(string path)
    {
        _activePath = path;
        _explorerOpen = false;
        if (_editor is not null)
        {
            await _editor.OpenFileAsync(path);
        }
    }

    /// <summary>Refresh do lado direito (git + jobs) + badge do explorer.</summary>
    private async Task RefreshSideAsync()
    {
        _git = await Api.GetWorkspaceGitAsync();
        _jobs = await Api.GetJobsAsync(all: true);
        _checkpoints = await Api.GetCheckpointsAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Botão ▶ do header — inicia o test run (RF-004).</summary>
    private Task RunTestsAsync() => TestRun.StartAsync();

    /// <inheritdoc/>
    protected override void OnInitialized() => TestRun.Changed += OnTestRunChanged;

    private void OnTestRunChanged() => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc/>
    public void Dispose()
    {
        TestRun.Changed -= OnTestRunChanged;
        _poll?.Dispose();
    }
}
