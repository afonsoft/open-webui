@page "/notes/new"
@page "/notes/{Id}"
@inject ApiService Api
@inject NavigationManager Nav
@inject LocalizationService L

<PageTitle>@_title — Open WebUI</PageTitle>

<div class="page">
    <div class="page-header">
        <h1 class="page-title">@_title</h1>
        <button class="msg-action" @onclick="GoBack">← @L["common.back"]</button>
    </div>

    @if (_notFound)
    {
        <div class="sidebar-empty">@L["common.not_found"]</div>
    }
    else if (_loading)
    {
        <div class="sidebar-empty">@L["common.loading"]</div>
    }
    else
    {
        <div class="card-list">
            <div class="card-row">
                <div class="card-main w-full">
                    <div class="grid gap-3">
                        <div class="field">
                            <label>@L["common.title"]</label>
                            <input class="input" @bind="_name" />
                        </div>
                        <div class="field">
                            <label>@L["common.content"]</label>
                            <textarea class="input" rows="14" @bind="_content"></textarea>
                        </div>
                    </div>
                    @if (_error is not null)
                    {
                        <div class="text-sm text-red-500 mt-2">@_error</div>
                    }
                </div>
                <div class="card-actions">
                    <button class="auth-submit" @onclick="SaveAsync">@L["common.save"]</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Id { get; set; }

    private bool _loading = true;
    private bool _notFound;
    private string _name = "";
    private string _content = "";
    private string? _error;
    private string _title => Id is null ? L["notes.new"] : L["notes.edit"];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _notFound = false;
        if (Id is not null)
        {
            var note = await Api.GetNoteAsync(Id);
            if (note is null)
            {
                _notFound = true;
            }
            else
            {
                _name = note.Title;
                _content = note.Content;
            }
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _error = null;
        var saved = Id is null
            ? await Api.CreateNoteAsync(
                string.IsNullOrWhiteSpace(_name) ? L["notes.untitled"] : _name.Trim(), _content)
            : await Api.UpdateNoteAsync(Id, _name.Trim(), _content);

        if (saved is null)
        {
            _error = L["common.save_failed"];
            return;
        }
        Nav.NavigateTo("/notes");
    }

    private void GoBack() => Nav.NavigateTo("/notes");
}
