    protected override async Task OnInitializedAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        await ReloadUsersAsync();
        _groups = await Api.GetGroupsAsync();
        _analytics = await Api.GetAnalyticsAsync(30);
        _feedbacks = await Api.GetAllFeedbacksAsync();
        _leaderboard = await Api.GetLeaderboardAsync();
        await ReloadAdminChatsAsync();
        _adminConfig = await Api.GetAdminConfigAsync();
        _appConfig = await Api.GetAppConfigAsync();
        _mcpServers = await Api.GetMcpServersAsync();
        foreach (var server in _mcpServers)
        {
            _mcpTools[server.Id] = await Api.GetMcpToolsAsync(server.Id);
        }
        if (_adminConfig is not null)
        {
            _flagSignup = _adminConfig.EnableSignup;
            _flagLoginForm = _adminConfig.EnableLoginForm;
            _flagApiKeys = _adminConfig.EnableApiKeys;
            _flagRating = _adminConfig.EnableMessageRating;
            _flagFolders = _adminConfig.EnableFolders;
            _flagMemories = _adminConfig.EnableMemories;
        }

        _webUiName = _adminConfig?.WebUiName ?? "";
        var signup = await Api.GetSignupConfigAsync();
        _defaultRole = signup?.DefaultUserRole ?? "pending";
        _jwtExpiresIn = (await Api.GetJwtExpiryAsync())?.ExpiresIn ?? "7d";
        var models = await Api.GetModelsConfigAsync();
        _defaultModels = models?.DefaultModels.ToList() ?? [];
        _availableModels = await Api.GetModelsAsync();
        _connections = await Api.GetConnectionsAsync();
        _suggestions = models?.PromptSuggestions?.ToList() ?? [];
        _banners = await Api.GetBannersAsync();
        _toggleChannels = await Api.GetFeatureToggleAsync("channels", true);
        var codeExec = await Api.GetCodeExecutionConfigAsync();
        _toggleDirect = codeExec?.DirectConnections ?? false;
        _enginePyodide = codeExec?.Engines.Contains("pyodide") ?? true;
        _engineJupyter = codeExec?.Engines.Contains("jupyter") ?? false;
        var audio = await Api.GetAudioConfigAsync();
        if (audio is not null)
        {
            _sttEngine = audio.SttEngine;
            _sttBaseUrl = audio.SttBaseUrl;
            _sttKey = audio.SttApiKey;
            _sttModel = audio.SttModel;
            _sttProvider = audio.SttProvider;
            _ttsEngine = audio.TtsEngine;
            _ttsBaseUrl = audio.TtsBaseUrl;
            _ttsKey = audio.TtsApiKey;
            _ttsModel = audio.TtsModel;
            _ttsProvider = audio.TtsProvider;
            _ttsVoice = audio.TtsVoice;
            _azureRegion = audio.AzureRegion;
        }
        if (_sttEngine == "provider" && !string.IsNullOrWhiteSpace(_sttProvider))
        {
            await LoadSttProviderModelsAsync();
        }
        if (_ttsEngine == "provider" && !string.IsNullOrWhiteSpace(_ttsProvider))
        {
            await LoadTtsProviderModelsAsync();
        }
        var ret = await Api.GetRetrievalConfigAsync();
        if (ret is not null)
        {
            _retEngine = ret.Engine;
            _retSearxng = ret.SearxngBaseUrl;
            _retBrave = ret.BraveApiKey;
            _retTavily = ret.TavilyApiKey;
            _retTopK = ret.TopK;
            _retChunkSize = ret.ChunkSize;
            _retOverlap = ret.ChunkOverlap;
            _retHybrid = ret.Hybrid;
            _retWeight = ret.HybridWeight;
            _retRerank = ret.Rerank;
            _retRerankEngine = ret.RerankEngine;
            _retRerankUrl = ret.RerankExternalUrl;
            _retRerankKey = ret.RerankExternalApiKey;
            _retGooglePseKey = ret.GooglePseApiKey;
            _retGooglePseCx = ret.GooglePseEngineId;
            _retGooglePseBase = ret.GooglePseBaseUrl;
            _retJinaKey = ret.JinaApiKey;
            _retJinaBase = ret.JinaBaseUrl;
            _retExaKey = ret.ExaApiKey;
            _retExaBase = ret.ExaBaseUrl;
            _retKagiKey = ret.KagiApiKey;
            _retKagiBase = ret.KagiBaseUrl;
            _retPplxKey = ret.PerplexityApiKey;
            _retPplxBase = ret.PerplexityBaseUrl;
        }
        _terminals = await Api.GetTerminalServersAsync() ?? [];
        var saml = await Api.GetSamlConfigAsync();
        _samlEnabled = saml?.Enabled ?? false;
        _samlSsoUrl = saml?.IdpSsoUrl ?? string.Empty;
        _samlEntityId = saml?.IdpEntityId ?? string.Empty;
        _samlHasCert = saml?.HasCert ?? false;
        _samlSpEntity = saml?.SpEntityId ?? string.Empty;
        _samlRoleAttr = saml?.RoleAttribute ?? string.Empty;
        var scim = await Api.GetScimConfigAsync();
        _scimEnabled = scim?.Enabled ?? false;
        _scimHasToken = scim?.HasToken ?? false;
        _functions = await Api.GetFunctionsAsync() ?? [];
        _pipelineServers = await Api.GetPipelineServersAsync() ?? [];
    }

    private async Task SaveTerminalAsync()
    {
