@page "/admin"
@page "/admin/{Tab}"
@inject ApiService Api
@inject AuthService Auth
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject LocalizationService L

<PageTitle>@L["page.admin"] — Open WebUI</PageTitle>

<div class="page">
    <h1 class="page-title">@L["admin.title"]</h1>
    @if (!IsAdmin)
    {
        <div class="chat-error">@L["admin.restricted"]</div>
    }
    else
    {
        <div class="flex gap-2 mb-4 border-b border-gray-200 dark:border-gray-800 pb-2">
            <button class="text-sm px-3 py-1.5 rounded-full @(_tab == "users" ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                    @onclick='() => SetTab("users")'>@L["admin.users"]</button>
            <button class="text-sm px-3 py-1.5 rounded-full @(_tab == "groups" ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                    @onclick='() => SetTab("groups")'>@L["admin.groups"]</button>
            <button class="text-sm px-3 py-1.5 rounded-full @(_tab == "analytics" ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                    @onclick='() => SetTab("analytics")'>Analytics</button>
            <button class="text-sm px-3 py-1.5 rounded-full @(_tab == "evaluations" ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                    @onclick='() => SetTab("evaluations")'>@L["admin.tab_evaluations"]</button>
            <button class="text-sm px-3 py-1.5 rounded-full @(_tab == "leaderboard" ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                    @onclick='() => SetTab("leaderboard")'>@L["admin.tab_leaderboard"]</button>
            <button class="text-sm px-3 py-1.5 rounded-full @(_tab == "config" ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                    @onclick='() => SetTab("config")'>@L["admin.tab_config"]</button>
        </div>

        @if (_tab == "users")
        {
            if (_users is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="card-row">
                    <button class="auth-submit" @onclick="AddUserAsync">@L["admin.new_user"]</button>
                </div>
                <div class="card-row">
                    <div class="card-main w-full flex flex-wrap gap-2 items-center">
                        <input class="input flex-1 min-w-40" placeholder="@L["admin.search_users"]"
                               @bind="_userQuery" @bind:event="oninput"
                               @onchange="() => ReloadUsersAsync(1)" />
                        <select class="input w-32" @bind="_userFilter" @bind:after="() => ReloadUsersAsync(1)">
                            <option value="">@L["admin.all_roles"]</option>
                            <option value="admin">admin</option>
                            <option value="user">user</option>
                            <option value="pending">pending</option>
                        </select>
                        <select class="input w-36" @bind="_userOrderBy" @bind:after="() => ReloadUsersAsync(1)">
                            <option value="created_at">@L["admin.col_date"]</option>
                            <option value="name">@L["common.name"]</option>
                            <option value="email">@L["common.email"]</option>
                            <option value="role">Role</option>
                        </select>
                        <button class="msg-action" @onclick="ToggleDirection">
                            @(_userDirection == "desc" ? "↓" : "↑")
                        </button>
                    </div>
                </div>
                <div class="card-list">
                    @foreach (var user in _users)
                    {
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@user.Name <span class="role-badge role-@user.Role">@user.Role</span></div>
                                <div class="card-sub">@user.Email · @L.T("admin.created_at", ("date", FormatDate(user.CreatedAt)))</div>
                            </div>
                            <div class="card-actions">
                                @if (user.Role == "pending")
                                {
                                    <button class="msg-action" @onclick='() => SetRoleAsync(user, "user")'>@L["admin.approve"]</button>
                                }
                                @if (user.Role == "user")
                                {
                                    <button class="msg-action" @onclick='() => SetRoleAsync(user, "admin")'>@L["admin.make_admin"]</button>
                                }
                                @if (user.Role == "admin" && user.Id != Auth.CurrentUser?.Id)
                                {
                                    <button class="msg-action" @onclick='() => SetRoleAsync(user, "user")'>@L["admin.demote"]</button>
                                }
                                @if (user.Id != Auth.CurrentUser?.Id)
                                {
                                    <button class="msg-action danger" @onclick="() => DeleteUserAsync(user)">🗑</button>
                                }
                            </div>
                        </div>
                    }
                    @if (_users.Count == 0)
                    {
                        <div class="sidebar-empty">@L["admin.no_users"]</div>
                    }
                </div>
                @if (UsersTotalPages > 1)
                {
                    <div class="flex gap-2 items-center justify-center mt-3 text-sm">
                        <button class="msg-action" @onclick="() => ReloadUsersAsync(_usersPage - 1)"
                                disabled="@(_usersPage <= 1)">@L["admin.prev"]</button>
                        <span>@L.T("admin.page_of", ("page", _usersPage.ToString()), ("total", UsersTotalPages.ToString()))</span>
                        <button class="msg-action" @onclick="() => ReloadUsersAsync(_usersPage + 1)"
                                disabled="@(_usersPage >= UsersTotalPages)">@L["admin.next"]</button>
                    </div>
                }
            }
        }
        else if (_tab == "analytics")
        {
            if (_analytics is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@_analytics.Users.Total</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L.T("admin.users_card", ("count", _analytics.Users.New.ToString()))</div>
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@TotalMessages</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L["admin.messages"]</div>
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@TotalChats</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L["admin.chats"]</div>
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-2xl font-medium">@_analytics.Evaluations.Positive / @_analytics.Evaluations.Negative</div>
                        <div class="text-xs text-gray-500 dark:text-gray-400">@L["admin.evaluations"]</div>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-3">
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-sm font-medium mb-2">@L["admin.messages_per_day"]</div>
                        <BarChart Points="_analytics.Series.Messages" />
                    </div>
                    <div class="rounded-2xl bg-gray-50 dark:bg-gray-850 border border-gray-100 dark:border-gray-800/50 p-4">
                        <div class="text-sm font-medium mb-2">@L["admin.top_models"]</div>
                        @if (_analytics.Models.Count == 0)
                        {
                            <div class="sidebar-empty">@L["admin.no_data"]</div>
                        }
                        else
                        {
                            @foreach (var model in _analytics.Models)
                            {
                                <div class="flex justify-between text-sm py-1 border-b border-gray-100 dark:border-gray-800/50 last:border-0">
                                    <span class="truncate mr-2">@model.Model</span>
                                    <span class="text-gray-500">@model.Count</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        }
        else if (_tab == "evaluations")
        {
            if (_feedbacks is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else if (_feedbacks.Count == 0)
            {
                <div class="sidebar-empty">@L["admin.no_feedbacks"]</div>
            }
            else
            {
                <div class="card-list">
                    <div class="grid grid-cols-[1fr_1fr_80px_1fr_110px] gap-2 px-3 py-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <span>@L["admin.col_user"]</span>
                        <span>@L["admin.col_model"]</span>
                        <span>@L["admin.col_rating"]</span>
                        <span>@L["admin.col_reason"]</span>
                        <span>@L["admin.col_date"]</span>
                    </div>
                    @foreach (var fb in PagedFeedbacks)
                    {
                        <div class="card-row">
                            <div class="grid grid-cols-[1fr_1fr_80px_1fr_110px] gap-2 w-full text-sm">
                                <span class="truncate">@fb.UserName</span>
                                <span class="truncate text-gray-500">@(fb.ModelId ?? "—")</span>
                                <span>@(fb.Rating > 0 ? "👍" : "👎")</span>
                                <span class="truncate text-gray-500">@(fb.Reason ?? "—")</span>
                                <span class="text-gray-500">@FormatDate(fb.CreatedAt)</span>
                            </div>
                        </div>
                    }
                    @if (FeedbackPages > 1)
                    {
                        <div class="flex items-center gap-3 justify-center py-2 text-sm">
                            <button class="msg-action" disabled="@(_fbPage == 0)" @onclick="() => _fbPage--">@L["admin.prev"]</button>
                            <span class="text-gray-500">@L.T("admin.page_of", ("page", (_fbPage + 1).ToString()), ("total", FeedbackPages.ToString()))</span>
                            <button class="msg-action" disabled="@(_fbPage >= FeedbackPages - 1)" @onclick="() => _fbPage++">@L["admin.next"]</button>
                        </div>
                    }
                </div>
            }
        }
        else if (_tab == "leaderboard")
        {
            if (_leaderboard is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else if (_leaderboard.Count == 0)
            {
                <div class="sidebar-empty">@L["admin.no_leaderboard"]</div>
            }
            else
            {
                <div class="card-list">
                    <div class="grid grid-cols-[1fr_100px_100px_100px] gap-2 px-3 py-1.5 text-xs text-gray-500 dark:text-gray-400">
                        <span>@L["admin.col_model"]</span>
                        <span>@L["admin.col_rating_elo"]</span>
                        <span>@L["admin.col_battles"]</span>
                        <span>@L["admin.col_wins"]</span>
                    </div>
                    @foreach (var entry in _leaderboard)
                    {
                        <div class="card-row">
                            <div class="grid grid-cols-[1fr_100px_100px_100px] gap-2 w-full text-sm">
                                <span class="truncate">@entry.ModelId</span>
                                <span>@entry.Rating.ToString("F0")</span>
                                <span>@entry.Battles</span>
                                <span>@(entry.Wins % 1 == 0 ? entry.Wins.ToString("F0") : entry.Wins.ToString("F1"))</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (_tab == "config")
        {
            if (_adminConfig is null || _appConfig is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="flex gap-1 mb-3">
                    @foreach (var sub in new[] { "general", "models", "features" })
                    {
                        <button class="text-sm px-3 py-1.5 rounded-full @(_configTab == sub ? "bg-gray-200 dark:bg-gray-800" : "text-gray-500")"
                                @onclick="() => _configTab = sub">@L[$"admin.config_{sub}"]</button>
                    }
                </div>

                @if (_configTab == "general")
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <label class="check"><input type="checkbox" @bind="_flagSignup" /> @L["settings.allow_signup"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagLoginForm" /> @L["settings.allow_password_login"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagApiKeys" /> @L["settings.allow_api_keys"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagRating" /> @L["settings.enable_rating"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagFolders" /> @L["settings.enable_folders"]</label>
                                <label class="check"><input type="checkbox" @bind="_flagMemories" /> @L["settings.enable_memories"]</label>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main w-full flex flex-col gap-2">
                                <label class="text-sm text-gray-600 dark:text-gray-300">@L["admin.webui_name"]</label>
                                <input class="input" @bind="_webUiName" />
                                <label class="text-sm text-gray-600 dark:text-gray-300 mt-1">@L["admin.default_role"]</label>
                                <select class="input w-40" @bind="_defaultRole">
                                    <option value="pending">pending</option>
                                    <option value="user">user</option>
                                    <option value="admin">admin</option>
                                </select>
                                <label class="text-sm text-gray-600 dark:text-gray-300 mt-1">@L["admin.jwt_expires"]</label>
                                <input class="input w-40" @bind="_jwtExpiresIn" placeholder="7d" />
                            </div>
                        </div>
                        <div class="card-row">
                            @if (_configMessage is not null)
                            {
                                <div class="field-note">@_configMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveFlagsAsync">@L["common.save"]</button>
                        </div>
                    </div>
                }
                else if (_configTab == "models")
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="card-main w-full flex flex-col gap-2">
                                <label class="text-sm text-gray-600 dark:text-gray-300">@L["admin.default_models"]</label>
                                <input class="input" @bind="_defaultModelsText"
                                       placeholder="llama3, gpt-4o" />
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.suggestions"]</div>
                                <div class="card-sub">@L["admin.suggestions_hint"]</div>
                            </div>
                        </div>
                        @foreach (var suggestion in _suggestions.ToList())
                        {
                            <div class="card-row">
                                <div class="card-main w-full flex gap-2">
                                    <input class="input w-40" @bind="suggestion.Title" placeholder="@L["admin.suggestion_title"]" />
                                    <input class="input flex-1" @bind="suggestion.Content" placeholder="@L["admin.suggestion_content"]" />
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action danger" @onclick="() => _suggestions.Remove(suggestion)">🗑</button>
                                </div>
                            </div>
                        }
                        <div class="card-row">
                            <button class="msg-action" @onclick="AddSuggestion">@L["admin.add_suggestion"]</button>
                            @if (_configMessage is not null)
                            {
                                <div class="field-note">@_configMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveModelsConfigAsync">@L["common.save"]</button>
                        </div>
                    </div>

                    <div class="card-list mt-4">
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.banners"]</div>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main w-full flex flex-wrap gap-2 items-center">
                                <select class="input w-28" @bind="_bannerType">
                                    <option value="info">info</option>
                                    <option value="warning">warning</option>
                                    <option value="error">error</option>
                                    <option value="success">success</option>
                                </select>
                                <input class="input w-48" @bind="_bannerTitle" placeholder="@L["admin.banner_title"]" />
                                <input class="input flex-1" @bind="_bannerContent" placeholder="@L["admin.banner_content"]" />
                                <button class="auth-submit" @onclick="SaveBannerAsync">
                                    @(_editingBannerId is null ? L["common.new"] : L["common.save"])
                                </button>
                            </div>
                        </div>
                        @foreach (var banner in _banners)
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@banner.Title <span class="role-badge">@banner.Type</span></div>
                                    <div class="card-sub">@banner.Content</div>
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action" @onclick="() => EditBanner(banner)">✎</button>
                                    <button class="msg-action danger" @onclick="() => DeleteBannerAsync(banner)">🗑</button>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <label class="check"><input type="checkbox" @bind="_toggleChannels" /> channels</label>
                                <label class="check"><input type="checkbox" @bind="_toggleDirect" /> direct_connections</label>
                                <label class="check"><input type="checkbox" @bind="_enginePyodide" /> code exec: pyodide</label>
                                <label class="check"><input type="checkbox" @bind="_engineJupyter" /> code exec: jupyter</label>
                            </div>
                        </div>
                        <div class="card-row">
                            @if (_configMessage is not null)
                            {
                                <div class="field-note">@_configMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveFeaturesAsync">@L["common.save"]</button>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.terminals"]</div>
                            </div>
                        </div>
                        @foreach (var server in _terminals)
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@server.Name <span class="role-badge">@server.Type</span></div>
                                    <div class="card-sub">@server.Url (@server.AuthType)</div>
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action danger" @onclick="() => DeleteTerminalAsync(server)">🗑</button>
                                </div>
                            </div>
                        }
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <input class="input" @bind="_termName" placeholder="@L["admin.terminal_name"]" />
                                <input class="input" @bind="_termUrl" placeholder="http://jupyter:8888" />
                                <div class="flex gap-2">
                                    <select class="input" @bind="_termAuth">
                                        <option value="none">none</option>
                                        <option value="token">token</option>
                                        <option value="password">password</option>
                                    </select>
                                    <select class="input" @bind="_termType">
                                        <option value="jupyter">jupyter</option>
                                        <option value="pty">pty</option>
                                    </select>
                                </div>
                                @if (_termAuth is not "none")
                                {
                                    <input class="input" type="password" @bind="_termKey" placeholder="@L["admin.terminal_key"]" />
                                }
                                <button class="auth-submit" @onclick="SaveTerminalAsync">@L["admin.terminal_add"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.flags_readonly"]</div>
                                <div class="card-sub">
                                    notes: @FlagBadge(_appConfig.Features.EnableNotes) ·
                                    web search: @FlagBadge(_appConfig.Features.EnableWebSearch) ·
                                    images: @FlagBadge(_appConfig.Features.EnableImageGeneration) ·
                                    sharing: @FlagBadge(_appConfig.Features.EnableCommunitySharing)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            if (_groups is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="card-row">
                    <button class="auth-submit" @onclick="AddGroupAsync">@L["admin.new_group"]</button>
                </div>
                <div class="card-list">
                    @foreach (var group in _groups)
                    {
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@group.Name</div>
                                <div class="card-sub">
                                    @(group.Description ?? L["admin.no_description"]) ·
                                    @L.T("admin.member_count", ("count", group.Members.Count.ToString())) ·
                                    sharing: @(group.Permissions.Sharing?.PublicChats == false ? "off" : "on") ·
                                    prompts: @(group.Permissions.Workspace?.Prompts == false ? "off" : "on")
                                </div>
                                @if (group.Members.Count > 0)
                                {
                                    <div class="card-sub">
                                        @string.Join(", ", group.Members.Select(m => m.Name))
                                    </div>
                                }
                            </div>
                            <div class="card-actions">
                                <button class="msg-action" @onclick="() => AddMemberAsync(group)">@L["admin.add_member"]</button>
                                <button class="msg-action" @onclick="() => ToggleSharingAsync(group)">
                                    @(group.Permissions.Sharing?.PublicChats == false ? L["admin.allow_share"] : L["admin.block_share"])
                                </button>
                                <button class="msg-action danger" @onclick="() => DeleteGroupAsync(group)">🗑</button>
                            </div>
                        </div>
                    }
                    @if (_groups.Count == 0)
                    {
                        <div class="sidebar-empty">@L["admin.no_groups"]</div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    private List<AdminUserResponse>? _users;
    private int _usersTotal;
    private int _usersPage = 1;
    private string? _userQuery;
    private string _userFilter = "";
    private string _userOrderBy = "created_at";
    private string _userDirection = "desc";
    private const int UsersPerPage = 20;
    private int UsersTotalPages => Math.Max(1,
        (int)Math.Ceiling(_usersTotal / (double)UsersPerPage));
    private List<GroupResponse>? _groups;
    private AnalyticsResponse? _analytics;
    private List<AdminFeedbackResponse>? _feedbacks;
    private List<LeaderboardEntryResponse>? _leaderboard;
    private AdminConfig? _adminConfig;
    private AppConfigResponse? _appConfig;
    private string _tab = "users";
    private int _fbPage;
    private string _configTab = "general";
    private string _webUiName = "";
    private string _defaultRole = "pending";
    private string _jwtExpiresIn = "7d";
    private string _defaultModelsText = "";
    private List<PromptSuggestion> _suggestions = [];
    private List<BannerResponse> _banners = [];
    private string _bannerType = "info";
    private string _bannerTitle = "";
    private string _bannerContent = "";
    private string? _editingBannerId;
    private bool _toggleChannels = true;
    private bool _toggleDirect;
    private bool _enginePyodide = true;
    private bool _engineJupyter;
    private List<TerminalServerResponse> _terminals = [];
    private string _termName = "";
    private string _termUrl = "";
    private string _termAuth = "token";
    private string _termType = "jupyter";
    private string? _termKey;
    private bool _flagSignup;
    private bool _flagLoginForm;
    private bool _flagApiKeys;
    private bool _flagRating;
    private bool _flagFolders;
    private bool _flagMemories;
    private string? _configMessage;

    private const int FeedbackPageSize = 20;
    private int FeedbackPages => _feedbacks is null ? 0
        : (int)Math.Ceiling(_feedbacks.Count / (double)FeedbackPageSize);
    private IEnumerable<AdminFeedbackResponse> PagedFeedbacks => (_feedbacks ?? [])
        .Skip(_fbPage * FeedbackPageSize).Take(FeedbackPageSize);
    private static string FlagBadge(bool on) => on ? "on" : "off";

    private int TotalMessages => _analytics?.Series.Messages.Sum(d => d.Count) ?? 0;
    private int TotalChats => _analytics?.Series.Chats.Sum(d => d.Count) ?? 0;

    private bool IsAdmin => Auth.CurrentUser?.Role == "admin";

    protected override async Task OnInitializedAsync()
    {
        if (!IsAdmin)
        {
            return;
        }

        await ReloadUsersAsync();
        _groups = await Api.GetGroupsAsync();
        _analytics = await Api.GetAnalyticsAsync(30);
        _feedbacks = await Api.GetAllFeedbacksAsync();
        _leaderboard = await Api.GetLeaderboardAsync();
        _adminConfig = await Api.GetAdminConfigAsync();
        _appConfig = await Api.GetAppConfigAsync();
        if (_adminConfig is not null)
        {
            _flagSignup = _adminConfig.EnableSignup;
            _flagLoginForm = _adminConfig.EnableLoginForm;
            _flagApiKeys = _adminConfig.EnableApiKeys;
            _flagRating = _adminConfig.EnableMessageRating;
            _flagFolders = _adminConfig.EnableFolders;
            _flagMemories = _adminConfig.EnableMemories;
        }

        _webUiName = _adminConfig?.WebUiName ?? "";
        var signup = await Api.GetSignupConfigAsync();
        _defaultRole = signup?.DefaultUserRole ?? "pending";
        _jwtExpiresIn = (await Api.GetJwtExpiryAsync())?.ExpiresIn ?? "7d";
        var models = await Api.GetModelsConfigAsync();
        _defaultModelsText = string.Join(", ", models?.DefaultModels ?? []);
        _suggestions = models?.PromptSuggestions?.ToList() ?? [];
        _banners = await Api.GetBannersAsync();
        _toggleChannels = await Api.GetFeatureToggleAsync("channels", true);
        var codeExec = await Api.GetCodeExecutionConfigAsync();
        _toggleDirect = codeExec?.DirectConnections ?? false;
        _enginePyodide = codeExec?.Engines.Contains("pyodide") ?? true;
        _engineJupyter = codeExec?.Engines.Contains("jupyter") ?? false;
        _terminals = await Api.GetTerminalServersAsync() ?? [];
    }

    private async Task SaveTerminalAsync()
    {
        var saved = await Api.SaveTerminalServerAsync(new TerminalServerRequest(
            _termName.Trim(), _termUrl.Trim(), _termAuth,
            string.IsNullOrWhiteSpace(_termKey) ? null : _termKey, _termType));
        if (saved is not null)
        {
            _termName = string.Empty;
            _termUrl = string.Empty;
            _termKey = null;
            _terminals = await Api.GetTerminalServersAsync() ?? [];
        }
        _configMessage = saved is null ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private async Task DeleteTerminalAsync(TerminalServerResponse server)
    {
        await Api.DeleteTerminalServerAsync(server.Id);
        _terminals.RemoveAll(t => t.Id == server.Id);
    }

    private async Task SaveFlagsAsync()
    {
        if (_adminConfig is null)
        {
            return;
        }

        var updated = await Api.UpdateAppConfigAsync(_adminConfig with
        {
            WebUiName = _webUiName,
            DefaultUserRole = _defaultRole,
            EnableSignup = _flagSignup,
            EnableLoginForm = _flagLoginForm,
            EnableApiKeys = _flagApiKeys,
            EnableMessageRating = _flagRating,
            EnableFolders = _flagFolders,
            EnableMemories = _flagMemories,
        });
        if (updated is not null)
        {
            _adminConfig = updated;
            _appConfig = await Api.GetAppConfigAsync();
        }
        var jwtOk = await Api.UpdateJwtExpiryAsync(new JwtExpiryConfig(_jwtExpiresIn)) is not null;
        _configMessage = updated is null || !jwtOk ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private void AddSuggestion() => _suggestions.Add(new PromptSuggestion());

    private async Task SaveModelsConfigAsync()
    {
        var models = _defaultModelsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var updated = await Api.UpdateModelsConfigAsync(new ModelsConfig(models, _suggestions));
        _configMessage = updated is null ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private void EditBanner(BannerResponse banner)
    {
        _editingBannerId = banner.Id;
        _bannerType = banner.Type;
        _bannerTitle = banner.Title;
        _bannerContent = banner.Content;
    }

    private async Task SaveBannerAsync()
    {
        if (string.IsNullOrWhiteSpace(_bannerTitle))
        {
            return;
        }

        var request = new BannerRequest(_bannerType, _bannerTitle, _bannerContent, true);
        if (_editingBannerId is null)
        {
            await Api.CreateBannerAsync(request);
        }
        else
        {
            await Api.UpdateBannerAsync(_editingBannerId, request);
        }
        _editingBannerId = null;
        _bannerTitle = _bannerContent = string.Empty;
        _banners = await Api.GetBannersAsync();
    }

    private async Task DeleteBannerAsync(BannerResponse banner)
    {
        if (await Api.DeleteBannerAsync(banner.Id))
        {
            _banners.Remove(banner);
        }
    }

    private async Task SaveFeaturesAsync()
    {
        var engines = new List<string>();
        if (_enginePyodide) engines.Add("pyodide");
        if (_engineJupyter) engines.Add("jupyter");
        var ok = await Api.SetFeatureToggleAsync("channels", _toggleChannels)
            && await Api.UpdateCodeExecutionConfigAsync(
                new CodeExecutionConfig(engines, _toggleDirect)) is not null;
        _configMessage = ok ? L["admin.config_saved"] : L["settings.save_failed"];
    }

    [Parameter] public string? Tab { get; set; }

    protected override void OnParametersSet()
    {
        _tab = Tab is "users" or "groups" or "analytics" or "evaluations"
            or "leaderboard" or "config"
            ? Tab
            : "users";
    }

    private void SetTab(string tab) => Nav.NavigateTo($"/admin/{tab}");

    private async Task AddUserAsync()
    {
        var name = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.name"] + ":", "");
        var email = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.email"] + ":", "");
        var password = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.password"] + ":", "");
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            return;
        }

        var role = await JS.InvokeAsync<string?>("openwebui.prompt", L["admin.prompt_role"], "user");
        var created = await Api.AddUserAsync(new AddUserRequest(
            name ?? email, email, password,
            role is "admin" or "user" ? role : "user"));
        if (created)
        {
            await ReloadUsersAsync();
        }
    }

    private async Task ReloadUsersAsync(int page = 1)
    {
        var result = await Api.GetUsersAsync(
            _userQuery, _userFilter, _userOrderBy, _userDirection, page, UsersPerPage);
        _users = result.Users;
        _usersTotal = result.Total;
        _usersPage = result.Page;
    }

    private async Task ToggleDirection()
    {
        _userDirection = _userDirection == "desc" ? "asc" : "desc";
        await ReloadUsersAsync(1);
    }

    private async Task SetRoleAsync(AdminUserResponse user, string role)
    {
        var updated = await Api.UpdateUserAsync(user.Id,
            new AdminUpdateUserRequest(user.Name, role, null, user.ProfileImageUrl));
        if (updated is not null && _users is not null)
        {
            var index = _users.FindIndex(u => u.Id == user.Id);
            if (index >= 0)
            {
                _users[index] = user with { Role = role };
            }
        }
    }

    private async Task DeleteUserAsync(AdminUserResponse user)
    {
        if (await JS.InvokeAsync<bool>("openwebui.confirm",
            L.T("admin.confirm_delete_user", ("email", user.Email)))
            && await Api.DeleteUserAsync(user.Id))
        {
            _users?.Remove(user);
        }
    }

    private async Task AddGroupAsync()
    {
        var name = await JS.InvokeAsync<string?>("openwebui.prompt", L["admin.prompt_group_name"], "");
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        var description = await JS.InvokeAsync<string?>("openwebui.prompt", L["common.description"] + ":", "");
        var created = await Api.CreateGroupAsync(
            new CreateGroupRequest(name, description, null));
        if (created is not null)
        {
            _groups = await Api.GetGroupsAsync();
        }
    }

    private async Task AddMemberAsync(GroupResponse group)
    {
        var email = await JS.InvokeAsync<string?>("openwebui.prompt", L["admin.prompt_member_email"], "");
        if (string.IsNullOrWhiteSpace(email))
        {
            return;
        }

        var target = _users?.FirstOrDefault(
            u => u.Email.Equals(email.Trim(), StringComparison.OrdinalIgnoreCase));
        if (target is null)
        {
            await JS.InvokeAsync<bool>("openwebui.confirm", L["admin.user_not_found"]);
            return;
        }

        var updated = await Api.AddGroupMembersAsync(group.Id,
            new UpdateGroupMembersRequest([target.Id]));
        if (updated is not null)
        {
            _groups = await Api.GetGroupsAsync();
        }
    }

    private async Task ToggleSharingAsync(GroupResponse group)
    {
        var sharing = !(group.Permissions.Sharing?.PublicChats ?? true);
        var permissions = (group.Permissions ?? GroupPermissions.Full) with
        {
            Sharing = new SharingPermissions(sharing),
        };
        var updated = await Api.UpdateGroupAsync(group.Id,
            new UpdateGroupRequest(null, null, permissions));
        if (updated is not null)
        {
            _groups = await Api.GetGroupsAsync();
        }
    }

    private async Task DeleteGroupAsync(GroupResponse group)
    {
        if (await JS.InvokeAsync<bool>("openwebui.confirm",
            L.T("admin.confirm_delete_group", ("name", group.Name)))
            && await Api.DeleteGroupAsync(group.Id))
        {
            _groups?.Remove(group);
        }
    }

    private static string FormatDate(long unixSeconds) =>
        DateTimeOffset.FromUnixTimeSeconds(unixSeconds).ToString("dd/MM/yyyy");
}
