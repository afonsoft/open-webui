    private void EditMcpServer(McpServerResponse server)
    {
        _editingMcpId = server.Id;
        _mcpName = server.Name;
        _mcpTransport = server.Transport;
        _mcpCommand = server.Command ?? "";
        _mcpArgs = string.Join(" ", server.Args);
        _mcpEnv = string.Join(" ", server.EnvNames);
        _mcpUrl = server.Url ?? "";
        _mcpHeaders = string.Join("\n", server.Headers.Select(h => $"{h.Key}={h.Value}"));
    }

    private void ResetMcpForm()
    {
        _editingMcpId = null;
        _mcpName = _mcpCommand = _mcpArgs = _mcpEnv = _mcpUrl = _mcpHeaders = "";
        _mcpTransport = "http";
    }

    private McpServerUpsertRequest BuildMcpRequest(bool enabled) => new(
        _mcpName.Trim(),
        _mcpTransport,
        _mcpTransport == "stdio" ? _mcpCommand.Trim() : null,
        _mcpTransport == "stdio" ? _mcpArgs.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList() : null,
        _mcpTransport == "stdio" ? _mcpEnv.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList() : null,
        _mcpTransport == "http" ? _mcpUrl.Trim() : null,
        _mcpTransport == "http"
            ? _mcpHeaders.Split('\n', StringSplitOptions.RemoveEmptyEntries)
                .Select(line => line.Split('=', 2))
                .Where(p => p.Length == 2)
                .ToDictionary(p => p[0].Trim(), p => p[1].Trim())
            : new Dictionary<string, string>(),
        enabled);

    private async Task SaveMcpServerAsync()
    {
        var saved = _editingMcpId is null
            ? await Api.CreateMcpServerAsync(BuildMcpRequest(enabled: true))
            : await Api.UpdateMcpServerAsync(_editingMcpId,
                BuildMcpRequest(_mcpServers.First(s => s.Id == _editingMcpId).Enabled));
        _mcpMessage = saved is null ? L["settings.save_failed"] : L["admin.mcp_saved"];
        if (saved is not null)
        {
            ResetMcpForm();
            _mcpServers = await Api.GetMcpServersAsync();
        }
    }

    private async Task ToggleMcpServerAsync(McpServerResponse server)
    {
        var updated = await Api.UpdateMcpServerAsync(server.Id, new McpServerUpsertRequest(
            server.Name, server.Transport, server.Command, server.Args, server.EnvNames,
            server.Url,
            server.Headers.ToDictionary(h => h.Key, _ => "********"),
            !server.Enabled));
        if (updated is not null)
        {
            _mcpServers = await Api.GetMcpServersAsync();
        }
    }

    private async Task DeleteMcpServerAsync(McpServerResponse server)
    {
        if (await Api.DeleteMcpServerAsync(server.Id))
        {
            _mcpServers.RemoveAll(s => s.Id == server.Id);
            _mcpTools.Remove(server.Id);
            if (_editingMcpId == server.Id)
            {
                ResetMcpForm();
            }
        }
    }

    private async Task RefreshMcpAsync(McpServerResponse server)
    {
        var count = await Api.RefreshMcpServerAsync(server.Id);
        _mcpMessage = count >= 0
            ? L.T("admin.mcp_tools_found", ("count", count.ToString()))
            : L["settings.save_failed"];
        _mcpServers = await Api.GetMcpServersAsync();
        if (count >= 0)
        {
            _mcpTools[server.Id] = await Api.GetMcpToolsAsync(server.Id);
        }
    }

