    private void EditBanner(BannerResponse banner)
    {
        _editingBannerId = banner.Id;
        _bannerType = banner.Type;
        _bannerTitle = banner.Title;
        _bannerContent = banner.Content;
    }

    private async Task SaveBannerAsync()
    {
        if (string.IsNullOrWhiteSpace(_bannerTitle))
        {
            return;
        }

        var request = new BannerRequest(_bannerType, _bannerTitle, _bannerContent, true);
        if (_editingBannerId is null)
        {
            await Api.CreateBannerAsync(request);
        }
        else
        {
            await Api.UpdateBannerAsync(_editingBannerId, request);
        }
        _editingBannerId = null;
        _bannerTitle = _bannerContent = string.Empty;
        _banners = await Api.GetBannersAsync();
    }

    private async Task DeleteBannerAsync(BannerResponse banner)
    {
        if (await Api.DeleteBannerAsync(banner.Id))
        {
            _banners.Remove(banner);
        }
    }

    private async Task SaveAudioAsync()
    {
        var updated = await Api.UpdateAudioConfigAsync(new AudioConfig(
            _sttEngine, _sttBaseUrl, _sttKey, _sttModel,
            _ttsEngine, _ttsBaseUrl, _ttsKey, _ttsModel, _ttsVoice));
        _configMessage = updated is null ? L["settings.save_failed"] : L["admin.config_saved"];
        await JS.InvokeVoidAsync("openwebui.audio.refreshCaps");
    }
    private async Task SaveRetrievalAsync()
    {
        var updated = await Api.UpdateRetrievalConfigAsync(new RetrievalConfig(
            _retEngine, _retSearxng, _retBrave, _retTavily,
            _retTopK, _retChunkSize, _retOverlap,
            _retHybrid, _retWeight, _retRerank));
        _configMessage = updated is null ? L["settings.save_failed"] : L["admin.config_saved"];
