                                <select class="input w-52" @bind="_ttsEngine" @bind:after="OnTtsEngineChangedAsync">
                                    <option value="none">none</option>
                                    <option value="openai">openai</option>
                                    <option value="elevenlabs">elevenlabs</option>
                                    <option value="azure">azure</option>
                                    <option value="transformers">transformers</option>
                                    <option value="provider">@L["admin.engine_provider"]</option>
                                </select>
                                @if (_ttsEngine == "provider")
                                {
                                    <select class="input" @bind="_ttsProvider" @bind:after="LoadTtsProviderModelsAsync">
                                        <option value="">@L["admin.select_provider"]</option>
                                        @for (var i = 0; i < (_connections?.OpenAiBaseUrls.Count ?? 0); i++)
                                        {
                                            <option value="@_connections!.OpenAiBaseUrls[i]">@ConnectionLabel(i)</option>
                                        }
                                    </select>
                                    <select class="input" @bind="_ttsModel">
                                        <option value="auto">auto</option>
                                        @foreach (var m in _ttsProviderModels.Concat(
                                                string.IsNullOrWhiteSpace(_ttsModel) || _ttsModel == "auto" ? [] : [_ttsModel])
                                            .Distinct())
                                        {
                                            <option value="@m">@m</option>
                                        }
                                    </select>
                                    <input class="input" @bind="_ttsVoice" placeholder="alloy" />
                                }
                                else if (_ttsEngine is "openai" or "transformers")
                                {
                                    <input class="input" @bind="_ttsBaseUrl" placeholder="https://api.openai.com/v1" />
                                    <input class="input" type="password" @bind="_ttsKey" placeholder="API key" />
                                    <input class="input" @bind="_ttsModel" placeholder="tts-1" />
                                    <input class="input" @bind="_ttsVoice" placeholder="alloy" />
                                }
                                else if (_ttsEngine == "elevenlabs")
                                {
                                    <input class="input" @bind="_ttsBaseUrl" placeholder="https://api.elevenlabs.io (opcional)" />
                                    <input class="input" type="password" @bind="_ttsKey" placeholder="API key" />
                                    <input class="input" @bind="_ttsModel" placeholder="eleven_multilingual_v2" />
                                    <input class="input" @bind="_ttsVoice" placeholder="voice_id" />
                                }
                                else if (_ttsEngine == "azure")
                                {
                                    <input class="input" @bind="_azureRegion" placeholder="region (ex.: brazilsouth)" />
                                    <input class="input" @bind="_ttsBaseUrl" placeholder="base URL (opcional, sobrepõe a região)" />
                                    <input class="input" type="password" @bind="_ttsKey" placeholder="API key" />
                                    <input class="input" @bind="_ttsVoice" placeholder="pt-BR-FranciscaNeural" />
                                }
                            </div>
                        </div>
                        <div class="card-row">
                            @if (_configMessage is not null)
                            {
                                <div class="field-note">@_configMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveAudioAsync">@L["common.save"]</button>
                        </div>
                    </div>
                }
                else if (_configTab == "retrieval")
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="card-main w-full flex flex-col gap-2">
                                <label class="text-sm text-gray-600 dark:text-gray-300">@L["admin.search_engine"]</label>
                                <select class="input w-52" @bind="_retEngine">
                                    <option value="none">none</option>
                                    <option value="searxng">searxng</option>
                                    <option value="duckduckgo">duckduckgo</option>
                                    <option value="tavily">tavily</option>
                                    <option value="brave">brave</option>
                                    <option value="google_pse">google_pse</option>
                                    <option value="jina">jina</option>
                                    <option value="exa">exa</option>
                                    <option value="kagi">kagi</option>
                                    <option value="perplexity">perplexity</option>
                                </select>
                                @if (_retEngine == "searxng")
                                {
                                    <input class="input" @bind="_retSearxng" placeholder="http://searxng:8080" />
                                }
                                @if (_retEngine == "tavily")
                                {
                                    <input class="input" type="password" @bind="_retTavily" placeholder="tavily api key" />
                                }
                                @if (_retEngine == "brave")
                                {
                                    <input class="input" type="password" @bind="_retBrave" placeholder="brave api key" />
                                }
                                @if (_retEngine == "google_pse")
                                {
                                    <input class="input" type="password" @bind="_retGooglePseKey" placeholder="google pse api key" />
                                    <input class="input" @bind="_retGooglePseCx" placeholder="engine id (cx)" />
                                }
                                @if (_retEngine == "jina")
                                {
                                    <input class="input" type="password" @bind="_retJinaKey" placeholder="jina api key" />
                                }
                                @if (_retEngine == "exa")
                                {
                                    <input class="input" type="password" @bind="_retExaKey" placeholder="exa api key" />
                                }
                                @if (_retEngine == "kagi")
                                {
                                    <input class="input" type="password" @bind="_retKagiKey" placeholder="kagi api key" />
                                }
                                @if (_retEngine == "perplexity")
                                {
                                    <input class="input" type="password" @bind="_retPplxKey" placeholder="perplexity api key" />
                                }
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main w-full flex flex-col gap-2">
                                <label class="text-sm text-gray-600 dark:text-gray-300">top-k</label>
                                <input class="input w-28" type="number" @bind="_retTopK" />
                                <label class="text-sm text-gray-600 dark:text-gray-300">chunk size / overlap</label>
                                <div class="flex gap-2">
                                    <input class="input w-28" type="number" @bind="_retChunkSize" />
                                    <input class="input w-28" type="number" @bind="_retOverlap" />
                                </div>
                                <label class="check"><input type="checkbox" @bind="_retHybrid" /> hybrid (bm25+vector)</label>
                                @if (_retHybrid)
                                {
                                    <label class="text-sm text-gray-600 dark:text-gray-300">hybrid weight (0..1)</label>
                                    <input class="input w-28" type="number" step="0.1" min="0" max="1" @bind="_retWeight" />
                                }
                                <label class="check"><input type="checkbox" @bind="_retRerank" /> rerank</label>
                                @if (_retRerank)
                                {
                                    <select class="input w-52" @bind="_retRerankEngine">
                                        <option value="local">local</option>
                                        <option value="external">external</option>
                                    </select>
                                    @if (_retRerankEngine == "external")
                                    {
                                        <input class="input" @bind="_retRerankUrl" placeholder="http://reranker:8080/rerank" />
                                        <input class="input" type="password" @bind="_retRerankKey" placeholder="api key (opcional)" />
                                    }
                                }
                            </div>
                        </div>
                        <div class="card-row">
                            @if (_configMessage is not null)
                            {
                                <div class="field-note">@_configMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveRetrievalAsync">@L["common.save"]</button>
                        </div>
                    </div>
                }
                else if (_configTab == "mcp")
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.mcp_servers"]</div>
                                <div class="card-sub">@L["admin.mcp_servers_hint"]</div>
                            </div>
                        </div>
                        @foreach (var server in _mcpServers)
                        {
                            <div class="card-row flex-col items-stretch">
                                <div class="flex items-center justify-between gap-2 flex-wrap">
                                    <div class="card-main">
                                        <div class="card-title">
                                            @server.Name <span class="role-badge">@server.Transport</span>
                                            @if (!server.Enabled)
                                            {
                                                <span class="role-badge">@L["common.disabled"]</span>
                                            }
                                        </div>
                                        <div class="card-sub">
                                            @(server.Transport == "stdio" ? server.Command : server.Url)
                                            @if (server.LastError is not null)
                                            {
                                                <span class="text-red-500"> — @server.LastError</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="card-actions">
                                        <button class="msg-action" @onclick="() => RefreshMcpAsync(server)"
                                                aria-label="@L["admin.mcp_refresh"]">⟳</button>
                                        <button class="msg-action" @onclick="() => EditMcpServer(server)"
                                                aria-label="@L["common.edit"]">✎</button>
                                        <button class="msg-action" @onclick="() => ToggleMcpServerAsync(server)"
                                                aria-label="@L["common.toggle"]">@(server.Enabled ? "⏻" : "◌")</button>
                                        <button class="msg-action danger" @onclick="() => DeleteMcpServerAsync(server)">🗑</button>
                                    </div>
                                </div>
                                @if (_mcpTools.TryGetValue(server.Id, out var mcpTools) && mcpTools.Count > 0)
                                {
                                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-1">
                                        @string.Join(" · ", mcpTools.Select(t => t.Name))
                                    </div>
                                }
                            </div>
                        }
                        <div class="card-row">
                            <div class="card-main w-full flex flex-col gap-2">
                                <label class="text-sm text-gray-600 dark:text-gray-300">
                                    @(_editingMcpId is null ? L["admin.mcp_add"] : L["admin.mcp_edit"])</label>
                                <input class="input" @bind="_mcpName" placeholder="@L["admin.mcp_name"]" />
                                <select class="input w-52" @bind="_mcpTransport">
                                    <option value="http">http (streamable)</option>
                                    <option value="stdio">stdio (subprocess)</option>
                                </select>
                                @if (_mcpTransport == "http")
                                {
                                    <input class="input" @bind="_mcpUrl" placeholder="http://mcp-server:8000/mcp" />
                                    <input class="input" @bind="_mcpHeaders" placeholder="@L["admin.mcp_headers_hint"]" />
                                }
                                else
                                {
                                    <input class="input" @bind="_mcpCommand" placeholder="npx" />
                                    <input class="input" @bind="_mcpArgs" placeholder="-y mcp-server-everything" />
                                    <input class="input" @bind="_mcpEnv" placeholder="@L["admin.mcp_env_hint"]" />
                                }
                            </div>
                        </div>
                        <div class="card-row">
                            @if (_mcpMessage is not null)
                            {
                                <div class="field-note">@_mcpMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveMcpServerAsync">@L["common.save"]</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="card-list">
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <label class="check"><input type="checkbox" @bind="_toggleChannels" /> channels</label>
                                <label class="check"><input type="checkbox" @bind="_toggleDirect" /> direct_connections</label>
                                <label class="check"><input type="checkbox" @bind="_enginePyodide" /> code exec: pyodide</label>
                                <label class="check"><input type="checkbox" @bind="_engineJupyter" /> code exec: jupyter</label>
                            </div>
                        </div>
                        <div class="card-row">
                            @if (_configMessage is not null)
                            {
                                <div class="field-note">@_configMessage</div>
                            }
                            <button class="auth-submit" @onclick="SaveFeaturesAsync">@L["common.save"]</button>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.terminals"]</div>
                            </div>
                        </div>
                        @foreach (var server in _terminals)
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@server.Name <span class="role-badge">@server.Type</span></div>
                                    <div class="card-sub">@server.Url (@server.AuthType)</div>
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action danger" @onclick="() => DeleteTerminalAsync(server)">🗑</button>
                                </div>
                            </div>
                        }
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <input class="input" @bind="_termName" placeholder="@L["admin.terminal_name"]" />
                                @if (_termType is not "local")
                                {
                                    <input class="input" @bind="_termUrl" placeholder="http://jupyter:8888" />
                                }
                                else
                                {
                                    <small class="text-gray-500">@L["admin.terminal_local_hint"]</small>
                                }
                                <div class="flex gap-2">
                                    <select class="input" @bind="_termAuth">
                                        <option value="none">none</option>
                                        <option value="token">token</option>
                                        <option value="password">password</option>
                                    </select>
                                    <select class="input" @bind="_termType">
                                        <option value="jupyter">jupyter</option>
                                        <option value="pty">pty</option>
                                        <option value="local">local (spawn)</option>
                                    </select>
                                </div>
                                @if (_termAuth is not "none" && _termType is not "local")
                                {
                                    <input class="input" type="password" @bind="_termKey" placeholder="@L["admin.terminal_key"]" />
                                }
                                <button class="auth-submit" @onclick="SaveTerminalAsync">@L["admin.terminal_add"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.sso_saml"]</div>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <label class="toggle">
                                    <input type="checkbox" @bind="_samlEnabled" />
                                    <span>@L["admin.sso_enabled"]</span>
                                </label>
                                <input class="input" @bind="_samlSsoUrl" placeholder="IdP SSO URL" />
                                <input class="input" @bind="_samlEntityId" placeholder="IdP Entity ID" />
                                <textarea class="input" rows="3" @bind="_samlCert"
                                    placeholder="@(_samlHasCert ? "********" : "IdP X.509 PEM")"></textarea>
                                <input class="input" @bind="_samlSpEntity" placeholder="SP Entity ID (opcional)" />
                                <input class="input" @bind="_samlRoleAttr" placeholder="@L["admin.sso_role_attr"]" />
                                <button class="auth-submit" @onclick="SaveSamlAsync">@L["common.save"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.sso_scim"]</div>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <label class="toggle">
                                    <input type="checkbox" @bind="_scimEnabled" />
                                    <span>@L["admin.sso_enabled"]</span>
                                </label>
                                <input class="input" type="password" @bind="_scimToken"
                                    placeholder="@(_scimHasToken ? "********" : L["admin.scim_token"])" />
                                <button class="auth-submit" @onclick="SaveScimAsync">@L["common.save"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.functions"]</div>
                            </div>
                        </div>
                        @foreach (var fn in _functions)
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@fn.Name <span class="role-badge">@fn.Type</span></div>
                                    <div class="card-sub">@(fn.Active ? L["common.active"] : L["common.inactive"])</div>
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action" @onclick="() => ToggleFunctionAsync(fn)">
                                        @(fn.Active ? "⏻" : "▶")
                                    </button>
                                    <button class="msg-action danger" @onclick="() => DeleteFunctionAsync(fn)">🗑</button>
                                </div>
                            </div>
                        }
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <input class="input" @bind="_fnName" placeholder="@L["admin.function_name"]" />
                                <select class="input" @bind="_fnType">
                                    <option value="filter">filter</option>
                                    <option value="pipe">pipe</option>
                                    <option value="action">action</option>
                                </select>
                                <textarea class="input" rows="2" @bind="_fnManifest"
                                    placeholder="@L["admin.function_manifest"]"></textarea>
                                <textarea class="input" rows="2" @bind="_fnValves"
                                    placeholder="@L["admin.function_valves"]"></textarea>
                                <button class="auth-submit" @onclick="SaveFunctionAsync">@L["admin.function_add"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.pipelines"]</div>
                            </div>
                        </div>
                        @foreach (var pipe in _pipelineServers)
                        {
                            <div class="card-row">
                                <div class="card-main">
                                    <div class="card-title">@pipe.Name</div>
                                    <div class="card-sub">@pipe.Url @(pipe.HasKey ? "· 🔑" : "")</div>
                                </div>
                                <div class="card-actions">
                                    <button class="msg-action danger" @onclick="() => DeletePipelineServerAsync(pipe)">🗑</button>
                                </div>
                            </div>
                        }
                        <div class="card-row">
                            <div class="flex flex-col gap-2 w-full text-sm py-1">
                                <input class="input" @bind="_pipeName" placeholder="@L["admin.pipeline_name"]" />
                                <input class="input" @bind="_pipeUrl" placeholder="http://pipelines:9099" />
                                <input class="input" type="password" @bind="_pipeKey" placeholder="@L["admin.pipeline_key"]" />
                                <button class="auth-submit" @onclick="SavePipelineServerAsync">@L["admin.pipeline_add"]</button>
                            </div>
                        </div>
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@L["admin.flags_readonly"]</div>
                                <div class="card-sub">
                                    notes: @FlagBadge(_appConfig.Features.EnableNotes) ·
                                    web search: @FlagBadge(_appConfig.Features.EnableWebSearch) ·
                                    images: @FlagBadge(_appConfig.Features.EnableImageGeneration) ·
                                    sharing: @FlagBadge(_appConfig.Features.EnableCommunitySharing)
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
        else
        {
            if (_groups is null)
            {
                <div class="sidebar-empty">@L["common.loading"]</div>
            }
            else
            {
                <div class="card-row">
                    <button class="auth-submit" @onclick="AddGroupAsync">@L["admin.new_group"]</button>
                </div>
                <div class="card-list">
                    @foreach (var group in _groups)
                    {
                        <div class="card-row">
                            <div class="card-main">
                                <div class="card-title">@group.Name</div>
                                <div class="card-sub">
                                    @(group.Description ?? L["admin.no_description"]) ·
                                    @L.T("admin.member_count", ("count", group.Members.Count.ToString())) ·
                                    sharing: @(group.Permissions.Sharing?.PublicChats == false ? "off" : "on") ·
                                    prompts: @(group.Permissions.Workspace?.Prompts == false ? "off" : "on")
                                </div>
                                @if (group.Members.Count > 0)
                                {
                                    <div class="card-sub">
                                        @string.Join(", ", group.Members.Select(m => m.Name))
                                    </div>
                                }
                            </div>
                            <div class="card-actions">
                                <button class="msg-action" @onclick="() => AddMemberAsync(group)">@L["admin.add_member"]</button>
                                <button class="msg-action" title="@L["admin.group_domains"]" aria-label="@L["admin.group_domains"]"
                                        @onclick="() => EditDomainsAsync(group)">🌐</button>
                                <button class="msg-action" @onclick="() => ToggleSharingAsync(group)">
                                    @(group.Permissions.Sharing?.PublicChats == false ? L["admin.allow_share"] : L["admin.block_share"])
                                </button>
                                <button class="msg-action danger" @onclick="() => DeleteGroupAsync(group)">🗑</button>
                            </div>
                        </div>
                    }
                    @if (_groups.Count == 0)
                    {
                        <div class="sidebar-empty">@L["admin.no_groups"]</div>
                    }
                </div>
            }
        }
    }
</div>

