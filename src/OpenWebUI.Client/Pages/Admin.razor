    private async Task SaveTerminalAsync()
    {
        var saved = await Api.SaveTerminalServerAsync(new TerminalServerRequest(
            _termName.Trim(), _termUrl.Trim(), _termAuth,
            string.IsNullOrWhiteSpace(_termKey) ? null : _termKey, _termType));
        if (saved is not null)
        {
            _termName = string.Empty;
            _termUrl = string.Empty;
            _termKey = null;
            _terminals = await Api.GetTerminalServersAsync() ?? [];
        }
        _configMessage = saved is null ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private async Task DeleteTerminalAsync(TerminalServerResponse server)
    {
        await Api.DeleteTerminalServerAsync(server.Id);
        _terminals.RemoveAll(t => t.Id == server.Id);
    }

    private async Task SaveSamlAsync()
    {
        var saved = await Api.SaveSamlConfigAsync(new SamlConfigRequest(
            _samlEnabled, _samlSsoUrl.Trim(), _samlEntityId.Trim(),
            string.IsNullOrWhiteSpace(_samlCert) || _samlCert.Trim() == "********"
                ? "********" : _samlCert.Trim(),
            _samlSpEntity.Trim(), _samlRoleAttr.Trim()));
        _samlHasCert = saved?.HasCert ?? _samlHasCert;
        _samlCert = string.Empty;
        _configMessage = saved is null ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private async Task SaveScimAsync()
    {
        var saved = await Api.SaveScimConfigAsync(new ScimConfigRequest(
            _scimEnabled,
            string.IsNullOrWhiteSpace(_scimToken) || _scimToken.Trim() == "********"
                ? "********" : _scimToken.Trim()));
        _scimHasToken = saved?.HasToken ?? _scimHasToken;
        _scimToken = string.Empty;
        _configMessage = saved is null ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private async Task SaveFunctionAsync()
    {
        var saved = await Api.CreateFunctionAsync(new FunctionRequest(
            _fnName.Trim(), _fnType,
            string.IsNullOrWhiteSpace(_fnManifest) ? null : _fnManifest,
            string.IsNullOrWhiteSpace(_fnValves) ? null : _fnValves));
        if (saved is not null)
        {
            _fnName = string.Empty;
            _fnManifest = string.Empty;
            _fnValves = string.Empty;
            _functions = await Api.GetFunctionsAsync() ?? [];
        }
        _configMessage = saved is null ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private async Task ToggleFunctionAsync(FunctionResponse fn)
    {
        var updated = await Api.ToggleFunctionAsync(fn.Id);
        if (updated is not null)
        {
            var idx = _functions.FindIndex(f => f.Id == fn.Id);
            if (idx >= 0)
            {
                _functions[idx] = updated;
            }
        }
    }

    private async Task DeleteFunctionAsync(FunctionResponse fn)
    {
        await Api.DeleteFunctionAsync(fn.Id);
        _functions.RemoveAll(f => f.Id == fn.Id);
    }

    private async Task SavePipelineServerAsync()
    {
        var saved = await Api.SavePipelineServerAsync(new PipelineServerRequest(
            _pipeName.Trim(), _pipeUrl.Trim(),
            string.IsNullOrWhiteSpace(_pipeKey) ? null : _pipeKey));
        if (saved is not null)
        {
            _pipeName = string.Empty;
            _pipeUrl = string.Empty;
            _pipeKey = string.Empty;
            _pipelineServers = await Api.GetPipelineServersAsync() ?? [];
        }
        _configMessage = saved is null ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private async Task DeletePipelineServerAsync(PipelineServerResponse server)
    {
        await Api.DeletePipelineServerAsync(server.Id);
        _pipelineServers.RemoveAll(s => s.Id == server.Id);
    }

    private async Task SaveFlagsAsync()
    {
        if (_adminConfig is null)
        {
            return;
        }

        var updated = await Api.UpdateAppConfigAsync(_adminConfig with
        {
            WebUiName = _webUiName,
            DefaultUserRole = _defaultRole,
            EnableSignup = _flagSignup,
            EnableLoginForm = _flagLoginForm,
            EnableApiKeys = _flagApiKeys,
            EnableMessageRating = _flagRating,
            EnableFolders = _flagFolders,
            EnableMemories = _flagMemories,
        });
        if (updated is not null)
        {
            _adminConfig = updated;
            _appConfig = await Api.GetAppConfigAsync();
        }
        var jwtOk = await Api.UpdateJwtExpiryAsync(new JwtExpiryConfig(_jwtExpiresIn)) is not null;
        _configMessage = updated is null || !jwtOk ? L["settings.save_failed"] : L["admin.config_saved"];
    }

    private void AddSuggestion() => _suggestions.Add(new PromptSuggestion());

    private async Task SaveModelsConfigAsync()
    {
        var models = _defaultModelsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        var updated = await Api.UpdateModelsConfigAsync(new ModelsConfig(models, _suggestions));
