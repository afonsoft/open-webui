    private string ConnectionLabel(int index)
    {
        var name = _connections?.OpenAiNames?.ElementAtOrDefault(index);
        return !string.IsNullOrWhiteSpace(name)
            ? name!
            : _connections?.OpenAiBaseUrls.ElementAtOrDefault(index) ?? string.Empty;
    }

    private int? ProviderIndex(string? url)
    {
        if (string.IsNullOrWhiteSpace(url) || _connections is null)
        {
            return null;
        }
        var index = _connections.OpenAiBaseUrls.ToList().FindIndex(u =>
            string.Equals(u?.TrimEnd('/'), url.TrimEnd('/'), StringComparison.OrdinalIgnoreCase));
        return index < 0 ? null : index;
    }

    private async Task LoadProviderModelsAsync(string? providerUrl, Action<List<string>> assign)
    {
        var index = ProviderIndex(providerUrl);
        assign(index is null
            ? []
            : (await Api.GetConnectionModelsAsync("openai", index.Value))?.Data.Select(m => m.Id).ToList() ?? []);
    }

    private Task LoadSttProviderModelsAsync() =>
        LoadProviderModelsAsync(_sttProvider, list => _sttProviderModels = list);

    private Task LoadTtsProviderModelsAsync() =>
        LoadProviderModelsAsync(_ttsProvider, list => _ttsProviderModels = list);

    private Task OnSttEngineChangedAsync() =>
        _sttEngine == "provider" && _sttProviderModels.Count == 0
            ? LoadSttProviderModelsAsync()
            : Task.CompletedTask;

    private Task OnTtsEngineChangedAsync() =>
        _ttsEngine == "provider" && _ttsProviderModels.Count == 0
            ? LoadTtsProviderModelsAsync()
            : Task.CompletedTask;

